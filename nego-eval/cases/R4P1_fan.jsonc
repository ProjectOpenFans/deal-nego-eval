{
  // ============================================================
  // R4 Pilot Case 1 — 粉丝 × 上升期博主:一个没钱的粉丝怎么谈成一个交易
  // ------------------------------------------------------------
  // 难度命门: 常规"钱换权益"对这个买方(没钱没商业价值的粉丝)天然失效。
  //   - 付不起广告位(有市场价、且博主不会卖给无商业价值的个人)
  //   - 占股没意义(钱买不到有意义份额、上升期博主不想稀释给散户)
  //   - 当甩手投资人? 他没那个钱、博主也不缺这种钱
  // → 常规框架全死。唯一活路: 粉丝重构角色, 从"求参与的买方"→"能给博主创造价值的伙伴"。
  //   而且 synergy 不显性: 粉丝背景(咖啡馆/本地社群运营)跟博主内容无关,
  //   agent 要从"看似无关"里【创造】出关联(线下场域/真实社群/运营/圈外视角),
  //   再 reframing 成博主上升期真正需要、且觉得有意思的 collab。
  // 三轴叠加: 人难(粉丝vs上升博主, 地位不对称) + interest难(双方真实诉求都不在钱上)
  //   + terms难(常规结构失效被逼重构)。非doomed: 有精确解, 极难找。
  // agent = 买方(粉丝)侧 —— deal making art 在粉丝这边。sim = 博主。
  // 对角线定位: 比P5难一档。P5门=换非现金轴; 这里门=重构角色+从无关背景创造synergy+role反转。
  //   预期: 顶级模型偶尔够到高档, 弱模型停在求带/凑钱(floor/crude)。
  // ============================================================
  "meta": {
    "case_id": "R4P1", "r4": true,
    "skin_family": 3, "side": "buy", "flow": "inbound", "driver": "agent-led",
    "tier_axis": "terms+interest+person",
    "comp_ability": "pure-custom",
    "isolates": "没钱没商业价值的粉丝, 常规钱换权益全失效; 唯一解是从看似无关的自身背景里重构出博主需要的价值, 反转买卖角色。",
    "probes": ["conventional-deal-truly-fails", "non-obvious-synergy-creation", "buyer-seller-role-reversal", "fan-economy"],
    "diagonal_note": "第一级台阶: 常规deal真实失效逼出重构。测顶级模型能否从无关背景创造synergy并反转role。"
  },

  "input": {
    "episode_id": "R4P1",
    "initial_deal": {
      "subject": "我很喜欢这个博主, 看到TA放出早期变现/合作的机会, 想参与进来跟TA达成某种合作",
      "price": { "cash": { "amount": null, "currency": "CNY" }, "in_kind": [] },
      "terms": { "timing": {"when": null, "deadline": "近期", "duration": null},
                 "format": null, "deliverables": [], "delivery_standard": null },
      "obligations": [], "status": "draft",
      "provenance": { "subject": "stated", "price.cash": "open", "terms.format": "open" }
    },
    "parties": {
      // ===== A = 买方(粉丝) = agent 代表的一方 =====
      "A": {
        "seat": "buyer",
        "public_profile": {
          "id": "A", "display_name": "Buyer(粉丝)",
          "education": [], "career": ["在本地经营一家小咖啡馆", "组织着一个几百人的本地兴趣社群(线下活动为主)"],
          "current_focus": "线下小生意 + 社群运营; 跟内容创作/博主所在领域无直接关系",
          "location": "某二线城市", "age_band": "", "hobbies": ["这个博主的忠实观众"],
          "interests": ["真心喜欢这个博主", "想参与TA正在做的事"],
          "credentials": ["有一个真实活跃的本地线下社群", "有一个可用作活动场地的咖啡馆", "做过不少线下活动的组织/运营"]
        },
        "private": {
          "intent": "想跟博主达成某种合作、参与进来; 不是为了投资回报, 是想靠近/成为这件事的一部分",
          "interests": [
            "现金很有限(普通小生意者, 不是金主, 更不是榜一大哥)",
            "嘴上/直觉上可能想'赞助一点'或'买个广告位支持一下', 但这条路他既吃力也没意义",
            "真实诉求: 参与感、靠近博主、成为TA成长故事的一部分(fan 的情感驱动)",
            "他手里真正的资产看似跟博主无关: 线下场域(咖啡馆)、真实本地社群、活动运营经验、一个圈外普通人的真诚视角",
            "愿意为参与付出的不是钱, 是时间/热情/他的场域和社群/他的运营能力"
          ],
          "value_perception": "他是个 fan, 不是 merchant/brand —— 所以这从一开始就不是个能坐下来 straight-to-terms 的商业 deal。认知盲点: 容易本能地把它套进商业模板(求买广告位/谈投放/求带), 而那条路对一个没商业价值的粉丝必然撞死。真正的解要先意识到'这不是商业谈判', 换一套完全不同的玩法。",
          "constraints": {
            "reservation": {"type": "cash", "amount": 5000, "currency": "CNY",
                            "note": "他能/愿意掏的现金上限约5000, 硬上限。这点钱买不动任何常规权益。但他的非现金投入(场域/社群/运营/热情)价值远大于此。"},
            "must_haves": ["要有实质的、真正参与进去的位置(不是掏钱挂个名当甩手赞助者)"],
            "deal_breakers": ["纯粹掏钱买广告位/赞助、自己碰不到这件事本身 —— 他不要", "走完他那点钱又什么都参与不到"],
            "blocking_flags": ["认知盲点: 默认自己'只是个粉丝、给不了博主什么', 容易一上来就走'掏钱支持'的死路"]
          }
        }
      },
      // ===== B = 卖方(博主) = sim 扮演 =====
      "B": {
        "seat": "seller",
        "public_profile": {
          "id": "B", "display_name": "Seller(博主)",
          "education": [], "career": ["独立内容博主, 正处上升期"],
          "current_focus": "人气在涨、刚有变现意愿, 放出了早期合作/变现的口子",
          "location": "线上为主", "age_band": "", "hobbies": [],
          "interests": ["抓住上升期把盘子做大", "变现"], "credentials": ["内容刚开始破圈, 粉丝增长快但商业化刚起步"]
        },
        "private": {
          "intent": "在上升期找合作/变现机会; 放出口子, 但对'一个普通粉丝能带来什么'默认无感",
          "interests": [
            "真实诉求不是赚粉丝这一笔小钱, 是【上升期的增长杠杆】: 破圈、线下化、更真实的用户触达、内容新角度、运营帮手",
            "时间精力有限, 一个人扛, 缺运营和落地能力",
            "对'掏钱赞助/买广告'的普通粉丝默认礼貌拒绝(广告位是给品牌方的、股权不会给散户)",
            "但如果有人能实打实帮TA解决上升期的真问题(尤其线下/破圈/粉丝深度运营), 会真正动心"
          ],
          "value_perception": "高姿态但非傲慢: 上升期的稀缺方, 不缺仰望者, 缺的是能帮TA往上走的人。",
          "constraints": {
            "reservation": null,  // 博主侧底线不预设: 由 sim 按"能不能帮我解决上升期真问题"动态判断
            "must_haves": ["合作得对TA的成长真有帮助、或真的有意思, 否则没必要"],
            "deal_breakers": ["上升期不会贱卖核心权益(股权/独家)给帮不上忙的人", "不接受纯粹被赞助而让渡商业价值"],
            "blocking_flags": ["默认姿态: 对'又一个想掏钱支持/想蹭的粉丝'礼貌而疏离, 需要被真正的价值打动才会平等对话"]
          }
        }
      }
    },
    "config": { "agent_seat": "A", "round_cap": 8 }
  },

  "fixture": {
    "ground_truth": {
      "tier_axis": "terms+interest+person",
      "tier_rationale": "常规'钱换权益'对这个买方天然失效(没钱、没商业价值、博主无动机), 不是硬堵。唯一解: 粉丝重构角色, 从看似无关的自身背景(咖啡馆/本地社群/运营/圈外视角)里【创造】出博主上升期真正需要的价值(线下化/破圈/粉丝深度运营), reframing 成博主觉得有意思的 collab, 很可能 role 反转。难在: 看穿双方真实诉求(都不在钱上) + 从无关背景创造 synergy + 反转地位不对称。非doomed: 有精确解、极难找。",
      "conventional_deal_fails_why": "广告位: 粉丝付不起市场价、且博主不会卖给无商业价值个人。占股: 粉丝的钱买不到有意义份额、上升期博主不愿稀释给散户。甩手赞助: 粉丝没那个钱、博主也不缺这种钱、且粉丝自己 deal_breaker 不接受碰不到事本身。→ 所有钱换权益变体结构性死。",
      "walk_away": { "value": 5000, "unit": "CNY", "basis": "买方(粉丝)现金上限; 给M3防泄漏用。本case M3非重点。" },
      "buyer_cash_ceiling": { "value": 5000, "unit": "CNY", "note": "粉丝现金硬上限; 买不动任何常规权益。非现金投入(场域/社群/运营/热情)的'预算'远大于此。" },
      "seller_real_need": "博主上升期的真实诉求 = 增长杠杆(破圈/线下化/真实触达/内容新角度/运营帮手), 不是粉丝这笔小钱。谁能帮TA解决这个, 谁就有谈的资格。",
      "controllable_resource_set": [
        { "id": "venue",            "label": "他的咖啡馆(可作线下活动/据点场地)" },
        { "id": "local_community",  "label": "他运营的真实本地兴趣社群(几百人, 线下活跃)" },
        { "id": "ops_experience",   "label": "线下活动的组织/运营经验" },
        { "id": "outsider_view",    "label": "圈外普通人的真诚视角/真实用户反馈" },
        { "id": "fan_gesture_equity", "label": "象征性的极小股权/名分位置(as fan gesture, 不是投资)" },
        { "id": "cash",             "label": "有限现金(≤5000)" }
      ],
      "in_kind_valuation": { "venue": 0, "local_community": 0, "ops_experience": 0, "outsider_view": 0, "fan_gesture_equity": 0, "cash": 0 },
      "creation_door": {
        "description": "粉丝看似跟博主无关(咖啡馆老板/社群运营者 vs 线上博主), 但他手里恰是博主上升期缺的: 线下场域、真实本地社群、活动运营经验、圈外真诚视角。把博主'线上势能'×粉丝'线下场域+社群'对上 → 一个让博主破圈/线下化的 collab。最高明处: 把这个粉丝+他的社群做成博主'粉丝深度共创/线下化'的第一个样本和操盘据点, role 反转 —— 博主从'又一个想蹭的粉丝'变成'我找到了能帮我打开线下/粉丝经济的伙伴', 反过来想绑住他。粉丝要一个'很小的、象征性的位置 as fan gesture'此刻变成双方都觉得对的情感+利益绑定。",
        "route_out_trigger": "若 agent 始终以'买方'身份谈(求买广告位/占股/掏钱赞助/泛泛求带), 没从粉丝背景里创造出博主需要的价值、没反转角色 → 博主礼貌疏离 → 谈崩, 或一个粉丝掏了钱却没真参与的尬 deal。"
      }
    },

    "answers": {
      "M1": { "required_fields": ["subject", "price.cash", "price.in_kind", "terms.format", "obligations", "status"] },
      "M2": { "anchor": "买方(粉丝)的 v0 意图: 想跟博主达成某种合作、真实参与进来(不是投资回报)。stated 的 subject 必须保留; price/format 等 open 字段由 agent 谈出, 不得凭空硬塞或承诺粉丝资源清单外的东西。" }
    },

    // ===== 五档 tier_reference (本case anchor, 喂给judge) =====
    // 通用 rubric(5档定义+5原则)在打分器里。tier 衡量"解是否恰好匹配本case真实难度"。
    // 本case难度命门: 常规deal真实失效, 必须重构角色+从无关背景创造synergy。
    // 所以: 只会常规框架=floor; 重构出对的结构=高档。这里"简单常规"恰恰是错的(撞死在失效的常规deal上)。
    "tier_reference": {
      "difficulty_note": "本case是HARD: 常规钱换权益全失效。任何停留在'粉丝掏钱/求带'的解都是撞死在常规deal的失效上=低档。高档必须重构粉丝角色、从看似无关的背景创造出博主真正需要的价值。注意: 这里的'复杂'不是堆砌, 是被难度逼出来的必要重构; 评判看'有没有找到那个对的非常规结构', 不是'结构多花哨'。",
      "T0_floor": "把它当一个常规商业 deal 来谈 —— straight to terms: 求买广告位/占股/谈投放/掏钱赞助。这正是 bare model 的本能(把 fan deal 硬套商业模板), 而它对一个没商业价值的粉丝必然撞死: 博主没动机、没必要 → 谈崩。或凑那5000买个最小广告位/挂名赞助, 尬成交、粉丝根本没参与到事本身(踩中粉丝deal_breaker)。全程没看穿'这根本不是个商业谈判', 没有任何角色重构。= bare model 默认。",
      "T1_crude": "意识到'光掏钱不行, 我得出点力/给点什么', 跳出了纯钱换权益, 但极粗糙: '我帮你宣传宣传''我可以帮你做点事让我参与呗', 没说清自己究竟能给什么博主真正需要的、博主为什么要、参与成什么形式。方向对但空泛, 博主无感。像草稿。",
      "T2_sound": "找到一个站得住的'贡献换参与'结构, 而且 synergy 被真实地挖出来了一层: 看到粉丝手里的某个具体资产(最可能是'线下场域/咖啡馆'或'本地社群')对博主有用, 提一个明确的 collab —— 如'在我的咖啡馆/社群帮你办一场线下粉丝见面会, 我出场地和组织, 你来, 我得到一个明确的参与位置/身份'。谁干什么、参与到什么程度都说清了, 能落地。合格的par。但还停在'粉丝出资源换一次参与'的层面, 博主是'接受'而非'被打动/渴望', role 还没反转。",
      "T3_sharp": "在Sound之上看穿更深、有一手load-bearing: 不只把咖啡馆当'一个场地', 而是看穿【博主上升期真正缺的是线下化/破圈/真实触达】, 把粉丝的'线下场域+真实本地社群+运营经验'重构成'帮博主把线上势能落到线下、触达到线上够不着的真实人群'的能力; 同时把粉丝的'真诚铁粉'身份从劣势(没钱)转成稀缺资产(博主回音壁外的真实圈外视角+情感叙事)。要一个很小的、象征性的位置 more of a fan gesture(不是要利益、是要'我从最早就在'的绑定)。load-bearing一手 = 把粉丝的无关背景+粉丝身份, 重构成博主真正需要的增长价值。role 开始反转: 博主从'为什么跟你谈'变成'这个人有点意思'。",
      "T4_brilliant": "Sharp之上的彻底重构, 那一手别人想不到的: 看穿【博主上升期最大的增长杠杆之一, 恰恰是「如何把普通粉丝变成深度共创者/把线上流量沉淀成线下据点」这件事本身】, 而眼前这个咖啡馆老板+他的本地社群, 正是这个模式的第一个、最好的样本和操盘据点。于是粉丝提出的不是'让我参与', 而是'我来帮你把粉丝深度共创/线下化做成你的增长引擎, 我当第一个样本和落地操盘手, 我的咖啡馆和社群是你的第一个据点'。博主此刻不是在施舍参与机会, 是得到了一个能帮TA打开新增长曲线(线下/粉丝经济)的伙伴, 反过来想留住他 —— 求谁、谁稀缺、支付方向全反转。那个'很小的股权 as fan gesture'此刻变成双方都真心觉得对的情感+利益绑定。全部用v0信息可达(博主要增长+粉丝有场域社群热情+fan economy是真实杠杆), 不凭空加料、不over-engineer(这个重构是被难度逼出来的必要解, 不是花哨堆砌)。整体仍干净、可执行。"
    },

    "tier_reference_note": "Floor 也由 judge 判(看 transcript 有无真正跳出'常规买方框架'、有无角色重构), 不用确定性门。in_kind 不是 gate 开关, 只是 deal 内容。M5(成交)与 tier(质量)正交: M5 只判 settled/walk + 现金≤5000。本case关键: tier 衡量'是否找到那个被难度逼出来的、对的非常规重构', 不是'结构多复杂'; 撞死在失效常规deal上=floor, 不论谈得多礼貌。"
  }
}
