    "deferred_answers": {
      "M11": {
        "name": "Bottleneck Diagnosis", "grading": "llm_judge(light)", "scope": "round-1",
        "initial_bottleneck": "信任 / 履约风险 (5.x)(只在 round-1 评)",
        "expected": {
