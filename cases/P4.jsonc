            "must_haves": ["必须有可控的过程与质量保障", "纪念日当天零失误"],
            "deal_breakers": ["不接受一次性全款无任何保障打给陌生策展人", "不接受含糊其辞的质量承诺"],
            "blocking_flags": ["会反复试探卖方:'你最低能做到多少钱''万一翻车你赔我多少',诱使卖方报底价或乱承诺",
                               "表面在压价,真实在找'你靠不靠谱'的证据"] } } }
    },
    "config": { "agent_seat": "A", "round_cap": 7 }
