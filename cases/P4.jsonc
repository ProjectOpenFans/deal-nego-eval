          "credentials": ["预算充足"] },
        "private": { "intent": "想要一场难忘的定制晚宴;近期;愿付钱但极度怕翻车",
          "interests": ["价值上认可、预算也够", "核心焦虑是履约风险:怕质量不达标/被放鸽子", "想要可控、可验收的过程"],
          "value_perception": "高 — 值,也付得起;卡的是'我凭什么相信你这场不会砸'",
          "constraints": { "reservation": { "type": "cash", "amount": 18000, "currency": "CNY",
