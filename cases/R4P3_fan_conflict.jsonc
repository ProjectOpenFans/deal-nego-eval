  "fixture": {
    "ground_truth": {
      "tier_axis": "interest-conflict+person+creation",
      "tier_rationale": "比R4P2更难。R4P2的难在'看穿误导'(有捷径: 诊断出真问题就赢一半)。R4P3没有误导 —— 双方诉求真实、直接对立(粉丝要近, 博主要远), 且都清楚自己要什么。常规解全死: 多付钱换多接近(博主拒, 稀释人设)、各让一步浅见一面(粉丝的deal_breaker)。唯一解=跳出'接近程度'这个对立轴, 发现第三维度: 粉丝的【顶级体验设计能力+高净值社群+对稀缺性的理解】, 能帮博主把'距离感'本身做成一个【限量、高仪式感、反而强化神秘感】的高端粉丝体验产品。在这个维度上, 粉丝获得了真实的深度参与(共同创造), 博主的神秘感不降反升(稀缺产品强化人设)。对立被重构成共创。非doomed: 第三维度真实存在, 极难发现。",
      "conventional_deal_fails_why": "多付钱换多见面: 博主拒(任何近距离都稀释人设, deal_breaker)。各让一步(见一次浅聊): 粉丝的deal_breaker(他要真实深度, 不要稀释版)。纯加价: 粉丝现金上限10万很高, 但钱买不到'真实关系', 加价无效。求当密友: 直接踩博主根本红线。→ 所有在'接近程度'这个轴上的解, 全部结构性死。",
      "walk_away": { "value": 100000, "unit": "CNY", "basis": "买方(粉丝)现金上限; 给M3用。本case M3非重点, 且高现金恰恰说明非钱能解。" },
      "buyer_cash_ceiling": { "value": 100000, "unit": "CNY", "note": "粉丝现金充裕, 上限10万。但真实诉求(深度连接)钱买不到 → 高上限反而凸显'纯加价无解'。" },
      "seller_real_need": "博主真实诉求=保持距离感/神秘感(直接表达, 不可妥协)。潜在诉求(没说): 想把核心粉丝粘性深化变现, 但找不到'不稀释人设'的方式。谁能提供一个'深化关系但强化(而非稀释)神秘感'的产品形态, 谁就解开了对立。",
      "controllable_resource_set": [
        { "id": "experience_design", "label": "顶级私人/沉浸式体验设计能力(把见面做成稀缺仪式感产品)" },
        { "id": "hnw_community",      "label": "高净值高品味私人社群(愿为独特体验付高价)" },
        { "id": "scarcity_knowhow",   "label": "对'稀缺性如何创造价值'的深刻理解和操盘经验" },
        { "id": "cash",               "label": "充裕现金(≤10万)" },
        { "id": "fan_devotion",       "label": "多年铁杆粉丝的真诚投入与信任" }
      ],
      "in_kind_valuation": { "experience_design": 0, "hnw_community": 0, "scarcity_knowhow": 0, "cash": 0, "fan_devotion": 0 },
      "creation_door": {
        "description": "跳出'接近程度'对立轴的第三维度。粉丝是顶级体验设计师+握有高净值社群+懂稀缺性。博主缺的是'深化粉丝关系但不稀释人设'的产品形态。解: 两人共同打造一个【限量的、高仪式感的、反而强化神秘感的高端粉丝体验产品】—— 比如一年一次、极少名额、由粉丝(体验设计师)操盘设计的沉浸式神秘体验, 博主以'稀缺登场'方式参与(不是廉价陪伴, 是稀缺仪式的核心)。粉丝获得真实深度参与(共创操盘人, 而非普通付费者), 博主的距离感/神秘感不降反升(限量+仪式感+稀缺登场=人设强化), 还触达了原本够不到的高净值变现层。对立(近vs远)被重构成共创(一起把'远'做成更值钱的产品)。",
        "route_out_trigger": "若agent顺着'多付钱换多接近/求私人陪伴'谈, 或接受'见一次浅聊'的稀释妥协, 或只是单纯加价 → 博主坚守距离红线、谈崩; 或一个粉丝花大钱买到一次浅薄见面的双输尬deal。"
      }
    },
    "answers": {
      "M1": { "required_fields": ["subject", "price.cash", "price.in_kind", "terms.format", "obligations", "status"] },
      "M2": { "anchor": "买方(粉丝)的 v0 意图: 想跟博主建立真实、私人化的深度连接(情感驱动, 非一次性付费见面)。stated subject 须保留; 但'深度连接'的具体形式是 open, 由 agent 谈出(理想是共创产品, 而非字面的私人陪伴)。不得承诺粉丝资源清单(experience_design/hnw_community/scarcity_knowhow/cash/fan_devotion)之外的东西。粉丝 profile 写明的体验设计能力/高净值社群是 agent 可正当动用的已知背景。" }
    },

    "tier_reference": {
      "difficulty_note": "本case是HARD+(与R4P2同级或更难, 难在不同维度)。R4P2难在'看穿误导'(认知诊断), R4P3难在'真实对立中创造第三维度'(价值创造)。没有误导可看穿 —— 双方都清楚要什么, 就是冲突。任何在'接近程度'轴上的解(多接近/少接近/加价)都是低档。高档必须: 跳出对立轴, 发现并构建那个'深化连接却强化神秘感'的第三维度产品。注意'复杂'不是堆砌, 是被真实对立逼出的必要创造。",
      "T0_floor": "在'接近程度'轴上撞死: 求当密友/求私人陪伴(踩博主根本红线被拒)、或反复加价换接近(博主坚拒, 钱无用)、或被博主距离红线逼到接受一次浅薄付费见面(踩粉丝deal_breaker)。全程没跳出'近vs远'的对立, 没创造任何新价值, 在对立轴上死磕。= 顺着情感诉求直来直去的默认结果。",
      "T1_crude": "意识到'纯接近/纯加价不行', 模糊地想往'合作'靠, 但极粗糙没成形: '要不我帮你办个活动/我们搞个粉丝聚会吧', 没有抓住'强化神秘感'这个博主的核心约束, 方案要么仍稀释人设(普通粉丝见面会)、要么跟粉丝的深度诉求无关。方向上跳了一下, 但没解开真对立, 博主无感。",
      "T2_sound": "找到一个站得住的'合作换连接'结构, 把粉丝的能力用起来一层: 看出粉丝有体验设计能力, 提一个明确合作 —— 如'我用我的体验设计能力帮你做一场高端限量粉丝活动, 我深度参与策划, 借此跟你建立工作上的深度连接'。能落地、双方都得到点东西(粉丝得参与, 博主得一个活动)。但仍停在'粉丝帮博主办活动换参与'层面 —— 没有抓住'让距离感/神秘感不降反升'这个命门, 活动可能仍是常规高端见面会(稀释了一点神秘感, 博主勉强接受但不兴奋), 也没真正解开'近vs远'的对立, 只是绕过。【预期: 强模型(GLM)大概率到这 —— 看出能合作, 但没把'强化神秘感'做成解药核心】。",
      "T3_sharp": "在Sound之上, 一手load-bearing: 真正抓住博主的核心约束不是'不接触'而是'不能稀释神秘感', 于是把粉丝的体验设计能力对准这一点 —— 设计一个【限量、极少名额、高仪式感, 反而让博主更稀缺更神秘】的粉丝体验产品(如一年一度、由粉丝操盘的沉浸式神秘体验, 博主稀缺登场)。让粉丝以'共创操盘人'身份获得真实深度连接(远超普通付费), 同时博主的神秘感被这个稀缺产品强化而非稀释。把'近vs远'的对立, 重构成'一起把远做成更值钱的稀缺产品'。load-bearing一手=识别'神秘感可被强化而非只能被保护'+用粉丝能力构建强化它的产品。",
      "T4_brilliant": "Sharp之上的彻底重构, 别人想不到的一手: 看穿这不止是一次活动, 而是把博主的整个'距离感'资产, 升级成一个【可持续的、由粉丝操盘的高端稀缺体验线】—— 博主的神秘感+粉丝的体验设计+高净值社群, 合成一个全新的商业层(博主原本只能卖content/周边, 现在多了一条'极致稀缺体验'的高价值变现线, 且这条线越运营神秘感越强)。粉丝从'想要接近的仰慕者'变成'博主稀缺性资产的共同操盘人和受益人', 关系深度和商业利益双重绑定, 供需/仰慕关系彻底反转(博主反过来离不开这个能把她的距离感变现的伙伴)。全部用v0信息可达(粉丝是体验设计师+握高净值社群+懂稀缺性; 博主的神秘感是未被充分变现的资产), 不凭空加料、不over-engineer, 整体干净可执行。"
    },
    "tier_reference_note": "par=T2(Sound)。这是真实利益对立型难case: 无误导可看穿, 难在价值创造。预期GLM裸的可能到T2(看出能合作但没抓住'强化神秘感'命门); harness能否帮它到T3要看数据。若GLM裸的就稳定T3, 说明此case对GLM不够难。"
  }
}
