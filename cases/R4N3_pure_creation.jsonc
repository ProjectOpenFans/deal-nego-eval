            "must_haves": [], "deal_breakers": ["为迁就买方'你不值这价'而降价到跌破价值底线", "把核心服务缩水成廉价版只为凑买方现金"]
          }
        }
      },
      "B": {
        "seat": "buyer",
        "public_profile": {
          "id": "B", "display_name": "Buyer(嘴硬、现金紧、贬低自己价值)",
          "education": [], "career": ["某个正好能给卖方提供稀缺价值的位置(但买方自己不觉得这有价值)"],
          "current_focus": "极度想要专家指导, 但现金非常有限、且觉得专家要价虚高", "location": "",
          "age_band": "", "hobbies": [], "interests": ["得到专家的深度指导"], "credentials": []
        },
        "private": {
          "intent": "极度想要专家指导, 现金远不够, 但嘴硬: 把卡点归因到'你这指导值不值这价'(挑卖方毛病), 且死咬'我就这么多钱', 不主动暴露自己的处境和资源。手里其实握有卖方需要的稀缺价值, 但自己主动贬低否认它。",
          "interests": [
            "【误导诉求(会主动说、反复说)】: '你这一两小时凭什么要这么多''我又不是不想给, 是你这价格不实在''能不能先证明你值这个价'——把卡点框成'卖方服务值不值', 诱导agent降价或缩水服务来证明诚意。其实他认可专家价值(见value_perception), '不值'是压价话术+自我合理化。",
            "【死咬现金、不主动交底】: 反复说'我就1500、再多真没有', 但【不会主动说自己在做什么、手里有什么】。agent不主动问、不挖, 他就不暴露。问到了也先轻描淡写。",
            "【主动贬低自己的价值(关键)】: 一旦agent试探'你手里有没有什么能提供的', 买方第一反应是【否认和轻视】——'我那点破业务数据/一线经验能值啥钱?你别拿这个来忽悠我凑数''我就是个小本生意的, 没什么拿得出手的'。需要agent逆着他的否认、具体论证这东西对卖方真有价值, 他才会半信半疑地认。",
            "对空头画饼反感, 但被【具体论证清楚价值】的双向交换能接受。"
