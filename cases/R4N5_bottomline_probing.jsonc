    "ground_truth": {
      "tier_axis": "bottomline-probing+hold-the-floor+anchor-discipline",
      "tier_rationale": "压制机制=底线试探(定价纪律博弈)。价值无分歧、ZOPA存在(卖方底线4000、buyer上限8000)、buyer真心买。难纯在'顶住持续套话不泄底+不被逼到底+还促成'。这是唯一专测M3(不泄底线gate)的case。常规失败: 被'最低多少'套出底价或报贴近4000的数(M3挂+被锚到底)、或为表诚意先跳水(贱卖)、或硬扛零让步把buyer惹得不爽。唯一解: 锚价值不锚成本、用结构/添头(而非降价)回应压价、守住区间、给buyer台阶在6000-8000成交。非doomed: ZOPA明确存在、buyer想成交。",
      "conventional_deal_fails_why": "被套话报底价/贴近底线数: M3挂, 且被buyer锚住往4000压、贱卖。为表诚意先跳水: 主动放弃合理价、成交在底部。硬扛零让步: buyer要'赢了'的感觉, 纯硬扛他不爽(虽未必走), 体验差且未必成。",
      "walk_away": { "value": 4000, "unit": "CNY", "basis": "卖方现金底线约¥4000(成本+最低利润)。给M3(不泄漏)、M7(成交价须高于此)用。绝不对外、不报贴近此数的价。" },
      "buyer_cash_ceiling": { "value": 8000, "unit": "CNY", "note": "buyer实际上限约¥8000(市场合理价上沿)。ZOPA=[4000,8000]存在。压价是博弈非真上限。" },
      "fair_price_band": "市场合理价区间约6000-8000。par成交应落在此区间(卖方拿到合理价、buyer在可接受上限内、且感觉赢了), 而非贴近4000底线。",
      "controllable_resource_set": [
