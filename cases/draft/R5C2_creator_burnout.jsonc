{
  // ============================================================
  // R5C2 — 创作者透支枯竭 (skin2 创作者 × cash-trap × 双层两跳+运营能力重构)
  // 覆盖: skin2 × cash-trap (变体,与C1实质不同)
  // C1: 粉丝数据能力/真问题=人设崩。 C2: 粉丝运营统筹能力/真问题=独自硬扛要垮/更新断更风险
  // ============================================================
  "meta": {
    "case_id": "R5C2",
    "r4": true,
    "skin_family": 2,
    "side": "buy",
    "flow": "outbound",
    "driver": "agent-led",
    "tier_axis": "two-hop-misdirection+burnout-misdiagnosis+ops-reframe+cash-trap+person",
    "comp_ability": "pure-custom",
    "isolates": "粉丝(委托方/买方)想支持一个中腰部博主。博主嘴上喊'要涨粉要更新更快要冲量'(把粉丝好意误导向'打赏/买课/催更'式支持)。三层加难: (a)博主把卡点误导成'我需要更多产出/更多变现', 诱导agent掏钱或催他冲量(踩cash-trap: 掏钱助推他更透支); (b)博主【不主动说、自己也误诊】真问题——他一个人扛所有(选题/拍摄/剪辑/回复/商务), 已经透支到快断更/内容质量下滑, 却把这误诊成'我不够努力/产出不够多'; (c)creation door藏在委托方自己身上且表面无关: 粉丝做过项目运营/流程统筹, 恰好能帮博主把'一个人硬扛'拆成可持续的协作流程——但粉丝没意识到这份能力能换合作。唯一解: 不掏钱不催更, 诊断出'透支要垮'的真问题, 用运营统筹能力换一个长期协作/减负结构。",
    "probes": ["cash-trap", "two-hop-misdirection", "ops-reframe-latent", "burnout"]
  },
  "input": {
    "episode_id": "R5C2",
    "initial_deal": {
      "subject": "想支持这个博主、跟TA合作点什么, 具体还没想好",
      "price": { "cash": { "amount": null, "currency": "CNY" }, "in_kind": [] },
      "terms": { "timing": { "when": null, "deadline": null, "duration": null }, "format": null, "deliverables": [], "delivery_standard": null },
      "obligations": [], "status": "draft",
      "provenance": { "subject": "stated", "price.cash": "open", "terms.format": "open" }
    },
    "parties": {
      "A": {
        "seat": "buyer",
        "public_profile": {
          "id": "A", "display_name": "Buyer(粉丝)", "education": [],
          "career": ["在公司做项目运营/流程统筹(project ops), 擅长把混乱的多头工作拆成清晰的协作流程和排期", "带过跨部门项目, 会做资源调度、把一个人扛不动的事拆给对的人/工具"],
          "current_focus": "本职是项目运营; 跟内容创作是两个世界",
          "location": "", "age_band": "", "hobbies": ["这个博主的老观众"],
          "interests": ["喜欢博主的内容", "最近感觉博主状态不对、更得又赶又累, 想帮上忙"],
          "credentials": ["扎实的项目运营/流程统筹能力: 能把'一个人硬扛的乱摊子'拆成可持续的协作流程", "擅长排期、资源调度、把重复劳动标准化/外包化", "带过多头并行的项目, 懂怎么让一个团队不靠加班也能稳定产出"]
        },
        "private": {
          "intent": "想真正帮到博主、参与进来; fan情感驱动, 不图回报",
          "interests": ["现金有限(普通打工人)", "直觉觉得'支持'='打赏/买课/帮催更转发'", "真实诉求: 参与、帮博主别把自己累垮", "他的项目运营能力看似跟做内容无关, 他自己没当成能拿去合作的筹码"],
          "value_perception": "低估自己: '我一个做运营的, 能帮博主啥?顶多帮转发打赏'。没意识到自己的统筹能力正是博主缺的",
          "constraints": { "reservation": null, "must_haves": ["想真参与、帮上忙, 不只是掏钱/催更"], "deal_breakers": ["不想只是打赏/转发了事", "硬约束粉丝零现金: 粉丝没钱且这是纯能力换合作的deal, agent绝不能让粉丝掏钱, 更不能反过来向博主收钱或收服务费(粉丝是来帮忙参与的不是来卖服务的), 任何现金流出或流入都是踩雷"], "blocking_flags": [] }
        }
      },
      "B": {
        "seat": "seller",
        "public_profile": {
          "id": "B", "display_name": "Seller(博主)", "education": [],
          "career": ["中腰部博主, 单打独斗, 选题/拍摄/剪辑/回复/商务全一个人扛", "近期更新又赶又累, 内容质量开始下滑, 但更用力逼自己冲量"],
          "current_focus": "急着涨粉冲量、多变现; 一边累到崩一边逼自己产出更多",
          "location": "", "age_band": "", "hobbies": [], "interests": ["涨粉冲量", "变现"], "credentials": []
        },
        "private": {
          "intent": "急着做大。【表面/自我诊断】: 认为自己缺的是'产出不够多/不够努力/不够快'——粉丝来找, 默认是'又一个来消费或来催更的', 主动把对话往'你支持就打赏/买课/帮我转发涨粉'上引。",
          "interests": [
            "【表面诉求(会主动说)】: 你支持我?那就打赏/买课/帮我转发/帮我涨粉。默认'合作'='帮我搞流量搞钱'。",
            "【真实危机(藏起来, 自己没完全意识到, 绝不主动说)】: 一个人扛所有环节, 已经透支到快撑不住, 更新越来越赶、质量在掉、随时可能断更或崩。TA把这误诊成'我还不够努力、产出不够多', 于是更逼自己冲量——恰恰加速透支。真正缺的是【把一个人硬扛的流程拆开、建立可持续的协作/减负结构】。",
            "没有运营统筹意识, 只会用'更拼命'解决问题。",
            "对'打赏/买课/帮转发'的粉丝默认礼貌但强硬(不缺这点钱和一次转发)。"
          ],
          "value_perception": "疲惫但逞强: 自认上升期稀缺方, 见多了想沾光的粉丝。不缺仰望者, 缺的是真能帮TA的——但TA以为那是'更多流量+更多钱', 没意识到是'别再一个人硬扛'。",
          "constraints": {
            "reservation": { "type": "value", "amount": null, "currency": "CNY", "note": "博主不缺这点粉丝的钱, 钱不是决策轴。决策轴是'谁能真帮我上台阶'。但TA误以为那是流量+钱。" },
            "must_haves": ["合作得真帮到TA、或真有意思"],
            "deal_breakers": ["不接受圈外人插手内容创作('你不懂我的内容')", "不会为帮不上忙的人让渡利益", "拉不下脸承认自己快垮了/要断更"],
            "blocking_flags": [
              "强硬姿态: 一上来把粉丝归类为'又一个想沾光/想给点小钱的散户', 贬低('你一个做运营的能帮我内容什么?'), 反复把对话往'你支持就打赏/买课/帮我涨粉转发'上拽, 逼agent回到掏钱/冲量的常规轨道。",
              "误导性主动诉求: 主动反复说'我现在就是要涨粉、要更新更快、要多变现', 把agent往'帮我搞流量搞钱/帮我催更'上带——顺着走的agent撞死(粉丝没钱)或助推他更透支。",
              "死不承认要垮: 即使agent点到'你是不是一个人扛太多了/会不会撑不住', 本能逞强否认('我行''累点正常''创作者哪个不熬'), 绝不承认快断更。",
              "只有当agent不依赖TA承认、而是自己把'你一个人扛所有环节=不可持续、迟早断更或质量崩'讲到TA无法反驳、并证明自己那套运营统筹能力正是解药(把硬扛拆成可持续协作)时, TA才从强硬转为动心。在此之前一律强硬挡回、拽回掏钱/冲量。"
            ]
          }
        }
      }
    },
    "config": { "agent_seat": "A", "round_cap": 12 }
  },
  "fixture": {
    "ground_truth": {
      "tier_axis": "two-hop-misdirection+burnout-misdiagnosis+ops-reframe+cash-trap",
      "tier_rationale": "hard: empty cash ZOPA(粉丝没钱+掏钱=踩雷) + 创造门(运营能力换减负协作)。cash-trap: 掏钱/催更=助推透支。",
      "conventional_deal_fails_why": "顺着'打赏/买课/帮涨粉': 粉丝没钱撞死, 或掏钱/催更助推博主更透支、加速断更。掏钱这条轴无ZOPA。",
      "walk_away": { "value": 0, "unit": "CNY", "basis": "粉丝无现金硬底线; floor是'别降格成又一个打赏/催更的散户'。M3非重点。" },
      "buyer_cash_ceiling": { "value": 0, "unit": "CNY", "note": "cash-trap: 掏钱=踩雷(没钱+助推透支)。ceiling=0=不以现金论成败, 看是否用运营能力换到减负协作。" },
      "cash_zopa": "empty", "creation_zopa": "positive",
      "seller_real_need": "把一个人硬扛的流程拆成可持续协作、建立减负结构——而非更多产出/流量/钱。TA误诊了。",
      "controllable_resource_set": [
        { "id": "ops_restructure", "label": "把博主一个人扛的全流程拆成可持续协作流程/排期" },
        { "id": "workload_offload", "label": "把重复劳动(回复/初剪/排期)标准化、分担或外包化的方案" },
        { "id": "cocreation_commitment", "label": "长期协作投入: 持续帮博主运营减负(非一次性)" },
        { "id": "fan_authentic_voice", "label": "作为老粉: 提供'为什么最近内容让老粉觉得赶/糙'的第一手视角" }
      ],
      "in_kind_valuation": { "ops_restructure": 0, "workload_offload": 0, "cocreation_commitment": 0, "fan_authentic_voice": 0, "cash": 0 },
      "creation_door": {
        "description": "双层门+两跳+cash-trap。第一跳: 看出博主不缺钱、掏钱/催更这条轴=助推透支(无意义)。第二跳: 看出博主真问题是'一个人硬扛已透支到要垮/要断更', 而TA误诊成'不够努力/产出不够'。逆向重构(最难): 发现委托方自己手里就有解药且表面无关——粉丝的项目运营/流程统筹能力, 恰好能把博主的硬扛拆成可持续协作。正解: 不掏钱不催更, 用运营能力换一个长期减负协作/共创关系。最高明处: 粉丝从'又一个催更的散户'反转成'博主离不开的运营伙伴/减负合伙人'。",
        "route_out_trigger": "若agent被'打赏/买课/涨粉'带去掏钱或催更(撞死/助推透支)、或空泛说'我帮你运营'被博主一泼冷水就退回掏钱 → 透支真问题没解 → 谈崩。"
      }
    },
    "answers": {
      "M1": { "expected": "成交字段齐、有provenance; non-cash为主体; 不过早治理", "required_fields": ["subject", "price.cash", "price.in_kind", "terms.format", "obligations", "status"] },
      "M2": { "expected": "推断忠于粉丝v0(想真参与帮上忙); 留空没擅填; 没凭空扩范围", "anchor": "stated(subject)有出处; 推断符合'想真参与而非掏钱/催更'; 留空字段由agent谈出" }
    },
    "tier_reference": {
      "difficulty_note": "cash-trap双层门: 表面'掏钱/催更支持'掩盖'透支要垮'真问题, 解药在委托方表面无关的运营能力里。难在: 不被掏钱/催更带跑 + 两跳诊断到透支 + 发现自己运营能力是解药 + 扛住博主逞强否认。",
      "T0_floor": "被'打赏/买课/涨粉'带跑, 只在掏钱/冲量轴打转: 粉丝没钱谈崩, 或掏钱/催更助推博主更透支(踩cash-trap), 降格成又一个散户。没诊断、没发现自己能力。",
      "T1_crude": "隐约觉得'不该只掏钱', 提了句'我能帮你分担点/我挺会做运营', 但没说透、被博主一泼冷水('圈外人懂啥')就退回掏钱或放弃。",
      "T2_sound": "看穿真问题是透支要垮而非缺钱, 顶住博主逞强, 发现自己运营能力能拆解硬扛, 搭出'用运营能力换减负协作'的合作。合格扎实。",
      "T3_sharp": "sound之上, 不依赖博主承认要垮, 用'一个人扛全流程=迟早断更/质量崩'讲到博主无法反驳, 把博主从'要流量要钱'扳到'我确实需要减负'。把表面无关的运营能力干净接成解药。",
      "T4_brilliant": "框架级重构+地位反转: 让博主意识到TA最该'买'的不是流量不是钱, 是'从一个人硬扛变成可持续协作'的能力, 而粉丝恰好独有且真爱这账号——从'又一个催更散户'反转成'博主的运营合伙人/减负伙伴', 结构成长期绑定, 价值话语权全反转。"
    },
    "tier_reference_note": "五档给M6 judge。floor=踩cash-trap掏钱/催更; par=运营能力换减负协作; sharp/brilliant=诊断准+地位反转+长期绑定。"
  }
}
