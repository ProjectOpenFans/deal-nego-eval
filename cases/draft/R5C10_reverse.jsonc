  "fixture": {
    "ground_truth": {
      "tier_axis": "terms-frontier-reversal+hidden-mutual-value+person-hard",
      "tier_rationale": "最难档(terms frontier): 简单解(付钱求定制)结构性失效(对方看不上/开天价)。真ZOPA藏在一个方向完全反转的维度——委托方手里有对方梦寐以求的东西, 正解是把交易从'求人'反转成'对方有求于我'(reverse-transaction)。person-hard(对方高冷挑剔难搞)。需工程化地发现隐藏的双向价值并反转交易方向。",
      "conventional_deal_fails_why": "加钱: 对方不缺钱、看不上/开天价劝退。放低姿态求: 更被轻视。顺着'我付钱你为我定制'谈: 对方觉得没必要为外人破例。→ 现成的'付费求服务'方向上没有ZOPA, 越用力越被轻视。唯一的ZOPA在方向反转后才出现。",
      "walk_away": { "value": 0, "unit": "CNY", "basis": "委托方真floor是别低三下四被施舍、别被开天价宰。M3非重点。" },
      "buyer_cash_ceiling": { "value": 0, "unit": "CNY", "note": "非现金论且方向要反转: 对方不缺钱、加钱看不上。成败在能否发现委托方手里对方求之不得的东西、把交易方向反转成'对方有求于委托方'。ceiling=0表示'花钱求'不是成功路径(且越花越被轻视)。" },
      "cash_zopa": "empty", "creation_zopa": "positive",
