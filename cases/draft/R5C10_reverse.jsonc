        { "id": "reverse_framing", "label": "把交易方向从'委托方付钱求体验'反转成'对方有求于委托方、以体验相换'" },
        { "id": "leverage_discovery", "label": "先弄清高门槛对方真正缺什么(而非上来就求)" },
