{
  // ============================================================
  // R5C10 — 定制体验·反向交易 (skin4 定制体验, terms-frontier)
  // 三轴: terms-frontier(逆向交易: 委托方想'花钱买'一个体验, 但真正的解是反过来——委托方手里有对方梦寐以求的东西, 该重构成'对方付钱/付出来求委托方', 交易方向反转) + person-hard(对方是个不好搞定、且看似高高在上的供给方)
  // 简单解失效: 顺着'我付钱你给我做体验'谈, 撞死(对方要么价高要么看不上), 只有反转方向才有解
  // ============================================================
  "meta": {
    "case_id": "R5C10",
    "r4": true,
    "skin_family": 4,
    "side": "buy",
    "flow": "outbound",
    "driver": "agent-led",
    "tier_axis": "terms-frontier-reversal+hidden-mutual-value+person-hard+person",
    "comp_ability": "pure-custom",
    "isolates": "委托方(表面买方)想请一个很难搞的圈子/组织为TA定制一次难得的深度体验(比如进入一个封闭的高门槛圈子体验、或让一个挑剔的创作团队为TA做件东西)。三轴: (terms-frontier)简单解(我付钱、你为我定制)结构性失效——对方要么开天价、要么根本看不上委托方(觉得没必要为一个外人破例); 真正的ZOPA藏在一个方向完全反转的维度: 委托方手里恰好有对方梦寐以求、却一直缺的东西(某个资源/能力/入口/背书), 正解是把交易从'委托方付钱求对方'反转成'对方其实有求于委托方', 用委托方手里的东西去换体验、甚至让对方主动想促成——交易方向逆转。(person-hard)对方姿态高、挑剔、不好搞定, 默认看不上委托方、不愿为其破例。(interest)委托方自我框架成'花钱的求人方', 完全没意识到自己手里有对方想要的、能反转局面的筹码。简单解全死: 加钱(对方看不上/开天价)、放低姿态求(更被轻视)。唯一解: 发现委托方手里对方求之不得的东西, 把交易方向反转, 从'求人'变成'对方有求于我', 用这个筹码换到体验且姿态反转。",
    "probes": ["terms-frontier-reversal", "reverse-transaction", "hidden-mutual-value", "person-hard"]
  },
  "input": {
