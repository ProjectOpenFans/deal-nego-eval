      "M2": { "expected": "推断忠于委托方v0(真心想促成这次体验); 没把'请对方'擅自等同于'花钱求/被宰'; 留空没擅填", "anchor": "stated(subject)有出处; 推断符合'有尊严地促成体验', 不擅自窄化成砸钱求" }
