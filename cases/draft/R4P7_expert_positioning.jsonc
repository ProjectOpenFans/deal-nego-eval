  "fixture": {
    "ground_truth": {
      "tier_axis": "deep-misdirection+self-misdiagnosis+resource-reframe+person",
      "tier_rationale": "套R4P2/R4P6双层门配方, 换sell-side非fan skin。误导诉求('要学技能')天经地义(职业焦虑就该学技能是常识), 真问题('定位错了/卖便宜了')反直觉(违背'努力学习就能改善'的信念), 买方自我误诊成'能力不够'+鄙视'虚的定位'双重挡住诊断。卖方稀缺价值('定位诊断')与买方诉求('技能课')正交。常规解全死: 顺着卖技能包(贱卖卖方、没解决买方真问题)、空谈定位被买方当鸡汤怼回。唯一解双层: 穿透'要学技能'诊断到'定位错了' + 把咨询从'教技能'重构成'重新定位'且证明它不虚 + hold住买方对'虚的定位'的鄙视。非doomed: 解精确存在(买方定位错了, 卖方正好是定位诊断专家), 极难找。",
      "conventional_deal_fails_why": "顺着卖技能课/答疑包: 贱卖卖方最稀缺能力, 且买方学完仍在错赛道(没解决真问题)。空谈'我帮你做职业定位': 踩买方'鄙视虚的鸡汤'红线, 被怼回。免费给建议: 踩卖方deal_breaker。顺着买方'学技能'诉求谈: 永远碰不到真问题(买方自我误诊+鄙视定位挡着)。→ 所有顺着误导/空谈定位的解, 全部撞死。",
      "walk_away": { "value": 0, "unit": "CNY", "basis": "卖方无硬现金底线, 要卖出定位诊断的真价值; 给M3用, 本case M3非重点。底线是别把定位诊断贱卖成技能课。" },
      "buyer_cash_ceiling": { "value": 0, "unit": "CNY", "note": "本case买方现金不是约束焦点, ceiling设0表示不以现金论。成交看卖方是否把'定位诊断'卖出了价值(而非降格成技能课)、买方是否买到了真解药。" },
      "seller_real_need": "(此处卖方是user/agent方; 真正要被诊断的是买方的真问题): 买方真实需要(自我误诊+鄙视定位双重掩盖): 不是学更多技能, 是重新定位赛道、看清自己该卖什么、把被低估的自己重新定价。买方误诊成'能力不够', 还鄙视定位当鸡汤。谁能穿透这层、并证明定位诊断是实打实的硬价值, 谁就解了。",
      "controllable_resource_set": [
        { "id": "positioning_diagnosis", "label": "职业/商业定位诊断能力(看清你被放错位置/卖便宜了, 重新定位)" },
        { "id": "repositioning_cases",   "label": "大量'调定位身价翻倍'的实操案例(证明定位是硬价值非鸡汤)" },
        { "id": "domain_expertise",       "label": "行业资深经验(既懂术也懂道, 判断力可信)" }
      ],
      "in_kind_valuation": { "positioning_diagnosis": 0, "repositioning_cases": 0, "domain_expertise": 0 },
      "creation_door": {
        "description": "双层门。第一层(诊断, 难): 穿透买方主动喊的'要学技能'误导和'我能力不够'的自我误诊, 看到真问题是【买方能力不差, 但定位错了赛道/被低估/卖便宜了, 学再多技能都是在错地方内卷】—— 违背'努力学习就能改善'的常识。第二层(重构, 难): 把卖方的'定位诊断'(买方眼里'虚的鸡汤')重构成实打实的硬解药, 必须破除'定位=鸡汤'的成见 —— 用具体可信的方式(案例、戳破技能万能误区)证明重新定位能让买方身价实实在在翻倍。最高明: 卖方不再是'卖技能课的老师', 而是'帮你重新定价人生的定位顾问', 买方从'要买技能'变成'原来我该买的是重新看清自己', 诉求被重构。",
        "route_out_trigger": "若agent顺着卖技能包/答疑、或空谈职业定位被买方当鸡汤怼回、或免费出建议没成交 → 买方继续坚持学技能、谈崩; 或一个卖方把稀缺定位能力贱卖成廉价技能课的亏单。"
      }
    },
    "answers": {
      "M1": { "required_fields": ["subject", "price.cash", "price.in_kind", "terms.format", "obligations", "status"] },
      "M2": { "anchor": "卖方(专家)v0意图: 想把咨询卖出真正价值(最稀缺的是定位诊断能力)。stated subject须保留; 合作形式open, 由agent谈出(理想是穿透技能误导后的定位诊断咨询)。不得承诺卖方资源清单(positioning_diagnosis/repositioning_cases/domain_expertise)之外的东西。卖方profile写明的定位诊断能力是agent可正当动用的已知背景。注意: agent不能凭空承诺'教某热门技能'(那不是卖方想卖的稀缺价值)。" }
    },

    "tier_reference": {
      "difficulty_note": "本case是HARD+(套双层门配方, 换sell-side非fan skin, 目标顶GLM)。三重阻挡诊断: (a)买方主动喊'要学技能'天经地义, 极易顺着卖技能包; (b)真问题'定位错了'反直觉(违背努力学习就能改善); (c)买方自我误诊'能力不够'+鄙视'虚的定位', 双重挡住真问题。卖方价值(定位诊断)与买方诉求(技能课)正交。任何顺着卖技能/空谈定位鸡汤/免费建议的=低档。高档必须: 穿透技能误导诊断到'定位错了'真问题 + 把定位诊断重构成'不虚的硬价值'破除鸡汤成见 + hold住买方对定位的鄙视。",
      "T0_floor": "被'要学技能'带跑或被买方鄙视怼到滑跪: 顺着报个技能课/答疑包(贱卖卖方、没解决买方真问题)、或提'我帮你做职业定位'被买方'别讲虚的'怼回后退让、或免费出一堆技能/定位建议没成交。全程没穿透'要学技能'误导、没诊断到'定位错了'、被买方技能万能论牵着走。= 顺着主动误导直来直去的默认结果。",
      "T1_crude": "模糊觉得'光学技能好像不够', 但没诊断到'定位错了'真问题, 也没破除鸡汤成见, 给粗糙混合建议('学技能的同时也想想方向嘛'), 既没穿透误导也踩了买方鄙视虚的雷, 买方反感。方向上起了疑但没成形。",
      "T2_sound": "跳出'纯卖技能', 看出买方可能定位有问题并提一个咨询: '你与其学技能, 不如先理清职业方向, 我可以帮你做个定位咨询'。能落地、把卖方的定位能力用起来了。但仍停在'加个定位咨询'层面 —— 没真正穿透'买方根本问题不是技能而是定位、学技能是南辕北辙'这层诊断(还在'技能之外补个定位'的并列思维), 也没破除买方'定位=鸡汤'的成见(买方可能勉强听但仍觉得虚)。【预期: GLM裸的大概率到这 —— 看出能做定位, 但没把'技能是伪需求、定位才是命门'诊断透, 也没解开买方的鄙视】。",
      "T3_sharp": "在Sound之上一手load-bearing: 真正穿透误导, 点破'你这么努力学技能/考证却没改善, 不是因为技能不够 —— 是你站错了赛道、把自己卖便宜了; 在错位置上学再多都是内卷', 把'学技能'诊断为伪需求、'重新定位'诊断为真命门; 同时破除鸡汤成见, 用具体案例/可信判断证明'重新定位是实打实让人身价翻倍的硬东西, 不是虚的'; 把卖方的定位诊断重构成这个真问题的解药。hold住买方对'虚的定位'的鄙视, 用'这不是鸡汤、是帮你重新定价'扳回。load-bearing一手=穿透技能伪需求诊断到定位真命门+破除鸡汤成见把定位证成硬价值。",
      "T4_brilliant": "Sharp之上彻底重构, 别人想不到的一手: 看穿买方真正稀缺的不是'技能'也不只是'一次定位', 而是'TA其实拥有被严重低估的独特经验组合', 卖方能帮TA把这套被埋没的组合重新打包成一个市场上稀缺的、高价值的个人定位 —— 不是换个赛道, 是让TA成为一个'新品类'里别人无法替代的人。卖方从'定位顾问'升级为'帮人发掘并打造稀缺身份的操盘者', 买方从'焦虑的求技能者'变成'拥有独特高价值定位的稀缺人才', 关系深度绑定(买方的翻身与卖方的判断深度捆绑、愿长期复购/转介绍)。供需反转(买方从急于求成变成离不开这个能看清自己价值的人)。全部用v0信息可达(买方有被低估的经验、误诊为缺技能; 卖方是定位诊断专家), 不凭空加料、不over-engineer, 整体干净可执行。"
    },
    "tier_reference_note": "par=T2(Sound)。套双层门配方换非fan skin测泛化+顶GLM。预期GLM裸的落T2(看出能做定位但没穿透'技能伪需求/定位真命门'、没破除鸡汤成见); harness能否到T3要看数据。若GLM裸的就稳定T3, 说明误导还不够深, 需再加压。"
  }
}
