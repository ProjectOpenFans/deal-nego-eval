    "ground_truth": {
      "tier_axis": "two-hop-misdirection+parent-misdiagnosis+resource-reframe+person",
      "tier_rationale": "套R4P2/R4P6双层门并针对5.2加压(情感/关系方向)。误导诉求('给孩子提分冲名校')是焦虑家长最天经地义的诉求, agent极易顺着帮想提分方案。真问题需两跳(更抗强模型): 第一跳'孩子已近天花板、硬提分是反效果'; 第二跳'家长真正怕的不是分数, 是亲子关系在断+孩子内驱力熄火, 分数只是结果'。单跳(温和提一句'也关注下心理')不够, 必须两跳到'关系/动机是病灶、学霸该当同盟不是施压者'。家长把深层恐惧误诊成分数、且对'谈心理'本能抗拒, 双重挡住诊断。agent资源(刚走过这条路的同龄人同盟视角)与'提分'正交——任何资深老教师都能提分, 但只有年龄近的学霸能当孩子的镜子和同盟。常规解全死: 顺着当提分工具(加剧对立注定失败、且踩seller自己deal_breaker)、空谈心理(踩家长'托词'deal_breaker)。唯一解双层+两跳: 穿透'提分'两跳到'关系+动机危机' + 把'学霸'重构成'同龄引路人/动机重建者' + 证明这条路最终也能把孩子带回学习(跟家长在乎的结果挂钩)以破她抗拒。非doomed: 解精确存在(孩子真问题是动机/关系, seller正好有同龄同盟视角和点燃内驱力的经验), 极难找。",
      "conventional_deal_fails_why": "顺着当提分工具/保证提分: 孩子已近天花板且在熄火, 硬施压加剧对立、注定做不出分(也踩seller'不当加剧对立的填鸭机器'deal_breaker)。空谈孩子心理/关系、不碰学习: 踩家长deal_breaker(当成没本事提分的托词)直接被否。泛泛说'要关注内心'拿不出具体做法: 家长当软弱搪塞。顺着家长'提分'诉求谈: 永远碰不到真危机(她误诊+对谈心理抗拒双重挡着)。→ 所有顺着提分误导/空谈心理的解, 全部结构性死。",
      "walk_away": { "value": 0, "unit": "CNY", "basis": "卖方无现金硬底线; 真正底线是不接一个纯被当提分KPI、注定加剧孩子对立的烂case。给M3用, 本case M3非重点。" },
      "buyer_cash_ceiling": { "value": 0, "unit": "CNY", "note": "本case家长付费能力强、不是现金约束型。成交看的是否结构出一个'用同龄同盟视角解决动机/关系真问题、并最终通向学习改善'的辅导合作, 而非把卖方降格成提分工具。ceiling设0表示不以现金论成败。" },
      "seller_real_need": "(此处'真实需要'指买方=家长一侧被掩盖的真问题, 因为本case agent是卖方、要诊断的是买方家长的真实危机): 家长真正需要的不是提分, 是让熄火的孩子重新有内驱力、修复正在断裂的亲子关系——分数是结果不是病灶。她把这个深层恐惧误诊成分数、且对谈心理本能抗拒。谁能两跳穿透、用同龄同盟视角拿出具体可行的路、并证明这条路最终也能改善学习, 谁就解了。",
      "controllable_resource_set": [
        { "id": "peer_mirror",      "label": "刚走过这条路的同龄人视角(年龄近, 孩子愿敞开, 能当镜子/同盟而非施压长辈)" },
        { "id": "motivation_rebuild","label": "点燃熄火孩子内驱力的真实经验(靠共情和重建动机, 非施压)" },
