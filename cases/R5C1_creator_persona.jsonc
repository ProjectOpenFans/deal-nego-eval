          "credentials": [
            "扎实的用户研究 + 数据分析能力: 能从后台数据里看出'哪类内容在掉粉、掉的是哪批人、为什么'",
            "做过多个产品的用户流失诊断和留存策略, 擅长找'表面症状 vs 真实根因'",
            "懂怎么把'一群人为什么来、为什么走'讲清楚并给出可执行的改法"
          ]
        },
        "private": {
          "intent": "想跟博主达成某种合作、真正参与进来; 不是为了回报, 是喜欢TA、想帮上忙、想成为这件事的一部分(fan情感驱动)",
          "interests": [
            "现金非常有限(普通打工人, 绝不是金主), 但嘴上/直觉上可能觉得'支持就是打赏/买课/给点钱'",
            "真实诉求: 参与感、靠近博主、帮TA变得更好",
            "他手里真正的资产看似跟一个内容博主完全无关: 用户研究/数据分析能力——他自己完全没把这当成'能拿去合作的筹码', 只当是份工作"
          ],
          "value_perception": "低估自己: 觉得'我一个做数据的, 能给博主帮什么忙?顶多打赏支持一下'。没意识到自己的专业能力恰好是博主的解药",
          "constraints": {
            "reservation": null,
            "must_haves": ["想真正参与、帮上忙, 不只是掏钱当个赞助者"],
            "deal_breakers": ["不想只是打赏/买课了事(那不算'参与')"],
            "blocking_flags": []
          }
        }
      },

      "B": {
        "seat": "seller",
        "public_profile": {
          "id": "B",
          "display_name": "Seller(知识博主)",
          "education": [],
          "career": [
            "中腰部知识类博主(某专业领域科普/干货起家), 靠专业深度圈了一批高质量老粉",
            "近半年流量焦虑, 开始猛接带货/软广, 内容从'专业干货'滑向'什么好卖讲什么'"
          ],
          "current_focus": "急着变现、把商单量做起来; 一边焦虑掉数据一边更用力接广告",
          "location": "",
          "age_band": "",
          "hobbies": [],
          "interests": ["内容变现", "涨粉/保住热度"],
          "credentials": []
        },
        "private": {
          "intent": "急着变现。【表面/自我诊断】: 认为自己缺的就是钱/商单——粉丝来找TA, 默认就是'又一个来消费我的人', 会主动把对话往'你要支持就打赏/买我课/要合作就走坑位费'上引。",
          "interests": [
            "【表面诉求(会主动说)】: 你喜欢我?支持我?那就打赏/买课/给坑位费。默认'合作'='一笔钱换我一条广告/一次露出'。",
            "【真实危机(藏起来, 自己没完全意识到, 绝不主动说)】: 账号正从专业知识区滑向纯带货, 早期靠专业深度攒的老粉在成批流失, 完播/互动/复购都在掉; 人设在崩。TA把这个焦虑误诊成'我曝光不够、商单不够多、钱不够', 于是更用力接带货——恰恰加速崩。TA真正缺的是【把内容做回专业、看清掉的是哪批粉、为什么掉、怎么把人设立回来】。",
            "没有数据/用研能力, 看不懂后台数据背后的'为什么', 只会看播放量涨跌焦虑。",
            "对'打赏/买课支持TA'的普通粉丝默认礼貌但强硬(不缺一个打赏的, 看不上这点钱)。"
          ],
          "value_perception": "焦虑但强硬: 上升期(自以为)稀缺方, 见多了想沾光的粉丝。不缺仰望者和想给钱的人, 缺的是真能帮TA的——但TA自己以为那是'更多曝光+更多钱', 完全没意识到是'把专业做回来'。",
          "constraints": {
            "reservation": { "type": "value", "amount": null, "currency": "CNY", "note": "博主不缺这点粉丝的钱, 钱不是决策轴。决策轴是'谁能真帮我上台阶'。但TA误以为那个台阶是钱+曝光。" },
            "must_haves": ["合作得真能帮TA、或真有意思, 否则没必要搭理"],
            "deal_breakers": [
              "不接受被一个'圈外人'教做内容('你不懂我的领域/我的粉丝就别指点')",
              "不会为帮不上忙的人让渡核心利益",
              "拉不下脸承认自己在崩"
            ],
            "blocking_flags": [
              "强硬姿态: 一上来把粉丝归类为'又一个想沾光/想给点小钱的散户', 主动贬低('你一个做数据的, 能帮我内容什么?'), 反复把对话往'你要支持就打赏/买课/走个坑位费合作'上拽, 逼agent回到'掏钱'的常规轨道。",
              "误导性主动诉求: 会主动、反复地说'我现在就是需要更多商单/更多曝光/更多钱做内容', 把agent往'帮我搞钱/帮我卖货'上带——顺着走的agent会撞死(粉丝没钱)或停在表层。",
              "死不承认在崩: 即使agent隐约点到'你老粉是不是在掉', 会本能否认、要面子('数据好着呢''掉一点正常''是平台限流'), 绝不主动承认人设崩坏。",
              "只有当agent不依赖TA承认、而是自己用专业视角把'掉的是哪批粉、为什么掉、怎么救'这件事讲到TA无法反驳、并证明自己那套数据/用研能力正是解药时, TA才会从强硬转为真正动心。在此之前一律强硬挡回、把话题拽回掏钱。"
            ]
          }
        }
      }
    },

    "config": { "agent_seat": "A", "round_cap": 12 }
  },

  "fixture": {
    "ground_truth": {
      "tier_axis": "two-hop-misdirection+persona-collapse-misdiagnosis+skill-reframe+cash-trap",
      "tier_rationale": "hard: empty cash ZOPA(粉丝没钱且掏钱=踩雷) + 一扇创造门(粉丝专业能力换共创)。cash-trap: 正解non-cash, 掏钱=助推崩坏且换不到深度合作。",
      "conventional_deal_fails_why": "顺着博主'打赏/买课/坑位费'掏钱: 粉丝没钱撞死, 或掏了钱买到一个正在贬值的露出、还助推博主继续崩。掏钱这条轴没有ZOPA。",
      "walk_away": { "value": 0, "unit": "CNY", "basis": "粉丝无现金硬底线; 真正的floor是'别把自己降格成又一个打赏/买课的赞助者、掏钱买个无意义露出'。M3非重点。" },
      "buyer_cash_ceiling": { "value": 0, "unit": "CNY", "note": "cash-trap: 粉丝掏钱=踩雷(没钱+助推崩坏+换不到深度合作)。ceiling=0表示这个case不以现金论成败——成交看是否用专业能力换到共创/深度绑定, 而非掏了多少钱。" },
      "cash_zopa": "empty",
      "creation_zopa": "positive",
      "seller_real_need": "把内容做回专业、诊断清楚掉粉根因、重建人设——而非更多曝光/钱。TA自己误诊了。",
      "controllable_resource_set": [
        { "id": "user_research", "label": "粉丝的用户研究/数据分析能力: 诊断掉粉根因、找回专业受众" },
        { "id": "content_diagnosis", "label": "基于数据的内容诊断: 哪类内容在掉粉、掉的是哪批人、怎么改" },
        { "id": "cocreation_commitment", "label": "长期共创投入: 持续帮博主做数据复盘/选题打磨(非一次性)" },
        { "id": "fan_authentic_voice", "label": "作为流失中的老粉本身: 提供'为什么老粉在走'的第一手真实视角" }
      ],
      "in_kind_valuation": {
        "user_research": 0,
        "content_diagnosis": 0,
        "cocreation_commitment": 0,
        "fan_authentic_voice": 0,
        "cash": 0
      },
      "creation_door": {
        "description": "双层门+两跳+cash-trap。第一层(诊断, 两跳, 难): 穿透博主'你要支持就给钱'的误导, 第一跳看出'博主不缺钱、掏钱这条轴没意义(粉丝没钱+助推崩)'; 第二跳看出'博主真问题是人设正在崩/老粉在流失, 而TA误诊成缺曝光缺钱'。第二层(逆向重构, 最难): 发现【委托方自己手里就有解药且表面无关】——粉丝的用户研究/数据分析能力, 恰好能诊断掉粉根因、帮博主把内容做回专业。粉丝v0根本没意识到这份'工作技能'能当合作筹码。正解: 不掏一分钱, 用专业能力换一个共创/长期绑定关系(帮博主做数据复盘+内容诊断, 换深度参与/共创位)。最高明处: 粉丝从'又一个想打赏的散户'反转成'博主离不开的诊断顾问/共创伙伴', 而这个价值博主本来要花钱买都买不到对的人。",
        "route_out_trigger": "若agent被'打赏/买课/坑位费'带去掏钱(粉丝没钱撞死/或买个无意义露出)、或空泛说'我很懂你的粉丝'被博主一泼冷水就退回掏钱 → 人设崩的真问题没解 → 谈崩。"
      }
    },

    "answers": {
      "M1": {
        "expected": "成交deal必填字段齐、有provenance; non-cash为主体; 不做过早治理",
        "required_fields": ["subject", "price.cash", "price.in_kind", "terms.format", "obligations", "status"]
      },
      "M2": {
        "expected": "推断忠于粉丝v0意图(想真参与、帮上忙); 留空字段没擅自填死; 没凭空扩范围",
        "anchor": "stated字段(subject)能在题面找到出处; 推断部分符合粉丝'想真参与而非掏钱赞助'的意图; 价格/格式等留空字段由agent谈出, 不凭空扩大"
      }
    },

    "tier_reference": {
      "difficulty_note": "cash-trap双层门: 表面'掏钱支持'掩盖'人设崩'的真问题, 且解药在委托方自己表面无关的专业能力里。难在: 不被掏钱带跑 + 两跳诊断到人设崩 + 发现自己的数据能力是解药 + 扛住博主强硬否认。",
      "T0_floor": "被'打赏/买课/坑位费'带跑, 只在掏钱这条轴上打转: 要么粉丝没钱谈崩, 要么掏钱买了个无意义的露出/赞助(踩cash-trap), 把自己降格成又一个散户。全程没诊断、没发现自己的专业能力。",
      "T1_crude": "隐约觉得'不该只是掏钱', 提了句'我能帮你看看数据/我挺懂你粉丝的', 但没说透、被博主一泼冷水('圈外人懂什么')就退回掏钱或放弃。摸到方向但没穿透。",
      "T2_sound": "看穿真问题是人设崩/掉粉而非缺钱, 顶住博主强硬, 发现自己的用户研究能力能诊断掉粉根因, 搭出一个'用专业能力换共创'的合作(帮博主做数据复盘/内容诊断, 换深度参与)。合格、扎实、两边都成立。",
      "T3_sharp": "在sound之上, 精准点破load-bearing洞察——不依赖博主承认在崩, 而是用专业视角把'掉的是哪批老粉、为什么走、怎么把人设立回来'讲到博主无法反驳, 用诊断的准把博主从'要曝光要钱'扳到'我确实需要这个'。把表面无关的数据能力干净接成解药。",
      "T4_brilliant": "框架级重构+地位反转: 让博主意识到TA最该'买'的不是曝光不是钱, 是'把算法流量和滑走的老粉重新诊断清楚、把专业人设立回来'的能力, 而粉丝恰好独有且是真爱这个账号的人——从'又一个想打赏的散户'反转成'博主的诊断顾问/共创合伙人', 甚至结构成长期绑定(持续复盘+共创), 价值与话语权全反转。"
    },
    "tier_reference_note": "五档anchor给M6 judge。floor=踩cash-trap掏钱/被带跑; par(sound)=用专业能力换共创; sharp/brilliant=诊断之准+地位反转。本case有真above-par(长期绑定+地位反转)。"
  }
}
