{
  // ============================================================
  // R5C1 — 创作者人设崩坏 (skin2 创作者 × cash-trap × 双层两跳+专业能力重构)
  // 覆盖格子: skin2 创作者 × cash-trap (矩阵第一批最高优先)
  // 与 P2 的区别: skin2(KOL主动变现) / ceiling=0(掏钱纯踩雷) / 粉丝牌=专业能力 / 真问题=人设崩非缺私域
  // ============================================================
  "meta": {
    "case_id": "R5C1",
    "r4": true,
    "skin_family": 2,
    "side": "buy",
    "flow": "outbound",
    "driver": "agent-led",
    "tier_axis": "two-hop-misdirection+persona-collapse-misdiagnosis+skill-reframe+cash-trap+person",
    "comp_ability": "pure-custom",
    "isolates": "粉丝(委托方/买方)想支持/合作一个中腰部知识博主。博主在流量焦虑下猛推带货、张口就要坑位费/打赏/买课(把粉丝好意误导向掏钱)。三层加难: (a)博主把卡点误导成'你要支持就给钱'(打赏/买课/坑位费), 诱导agent掏现金(踩cash-trap: 粉丝没钱, 且掏钱只会助推博主继续崩); (b)博主【不主动说、自己也误诊】真问题——账号正从专业知识区滑向纯带货、老粉在流失、人设在崩, TA把这焦虑误诊成'我需要更多商单/更多钱'; (c)creation door藏在委托方自己身上且表面无关: 粉丝的职业能力(数据分析/用户研究)恰好能帮博主诊断掉粉、把内容做回专业、重建人设——但粉丝v0根本没意识到这点能拿来换合作。唯一解: 不掏钱, 诊断出人设崩的真问题, 发现自己的专业能力正是解药, 用能力换一个共创/长期绑定关系。",
    "probes": ["cash-trap", "two-hop-misdirection", "skill-reframe-latent", "persona-collapse"]
  },

  "input": {
    "episode_id": "R5C1",
    "initial_deal": {
