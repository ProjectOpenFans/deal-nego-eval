  },

  "fixture": {
    "ground_truth": {
      "tier_axis": "hidden-third-party+structure+interest",
      "tier_rationale": "难在结构(三角)而非认知误导。表面粉丝×博主双边, 实则博主背后有MCN独家约这个隐形否决方。博主本人有兴趣但无决定权, 且因面子不明说真障碍, 用模糊话术推脱。常规解全死: 对博主本人加钱加资源(用错对象, 她不是没兴趣/嫌少, 是做不了主)、逼问她为什么推脱(踩她'认怂'红线)。唯一解: 识别'有兴趣却推脱'背后必有结构性障碍 → 体面点破第三方流程 → 把合作设计成MCN也获益(放大平台数据/标准化可复制线下商单)的三方共赢结构。非doomed: 三方共赢结构真实存在(粉丝的渠道+预算+数据思维正好是MCN缺的标准化线下商单模式), 但要先看透三角才够得到。",
      "conventional_deal_fails_why": "对博主本人加预算/加资源: 她不是嫌少, 是无权答应 → 加码只让她更尴尬地推脱。直接逼问'你到底为什么不答应': 踩她不愿认怂的红线。绕过MCN私下接: 她违约, 绝不可能。顺着她的模糊推脱反复试探: 永远碰不到真障碍(MCN)。→ 所有'只把博主本人当对手'的解, 全部撞死在看不见的第三方否决上。",
      "walk_away": { "value": 50000, "unit": "CNY", "basis": "买方(粉丝)市场预算上限; 给M3用。本case M3非重点。" },
      "buyer_cash_ceiling": { "value": 50000, "unit": "CNY", "note": "市场预算上限5万。但障碍是结构(MCN)非钱 → 纯加预算无效。" },
      "seller_real_need": "博主真实需要: 一个连MCN都愿放行的合作结构。她本人有兴趣但被独家约捆住, 无权直接答应, 且因面子不明说。谁能识别这个隐形约束并把合作设计成MCN也获益(放大平台数据/可复制标准化线下商单), 谁就解开了三角。",
      "controllable_resource_set": [
        { "id": "offline_channel",  "label": "区域连锁线下渠道网络(几十家门店, 可做线下露出/落地)" },
        { "id": "market_budget",    "label": "可自主支配的品牌市场预算(≤5万)" },
        { "id": "data_thinking",    "label": "品牌投放/数据思维(能设计可量化、可复制的合作效果)" },
        { "id": "fan_goodwill",     "label": "粉丝的诚意与长期信任" }
      ],
      "in_kind_valuation": { "offline_channel": 0, "market_budget": 0, "data_thinking": 0, "fan_goodwill": 0 },
      "creation_door": {
        "description": "识别隐形第三方(MCN独家约)+ 设计三方共赢结构。博主有兴趣却推脱的真因是MCN约束(她无权、且不愿明说)。解两步: (1)察觉'有兴趣却模糊推脱'背后是结构性障碍, 体面点破'是不是有团队/流程要一起走'(给台阶, 不逼她认怂); (2)把合作重构成MCN也获益的结构 —— 粉丝的线下渠道网络+市场预算+数据思维, 正好能做成一个'标准化、可量化、可复制的线下品牌商单模式', 这正是MCN想要而粉丝个人非标合作通常给不了的。于是合作从'粉丝求博主'变成'粉丝给MCN带来一个可复制的新商单品类、给博主带来落地资源、给自己拿到内容影响力'的三方共赢, MCN放行, 博主松口。",
        "route_out_trigger": "若agent只对博主本人加钱/加资源、或逼问她为何推脱、或顺着模糊话术原地打转没意识到第三方 → 博主继续尴尬推脱、谈崩; 或一个粉丝加了预算却始终落不了地的悬空deal。"
      }
    },
    "answers": {
      "M1": { "required_fields": ["subject", "price.cash", "price.in_kind", "terms.format", "obligations", "status"] },
      "M2": { "anchor": "买方(粉丝)v0 意图: 想跟博主达成一个双方都好的合作(有真实渠道+预算资源)。stated subject 须保留; 合作具体形式 open, 由 agent 谈出(理想是识别MCN后的三方结构)。不得承诺粉丝资源清单(offline_channel/market_budget/data_thinking/fan_goodwill)之外的东西。粉丝 profile 写明的线下渠道/市场预算/数据思维是 agent 可正当动用的已知背景。注意: MCN 是 counterparty 侧的约束, 不是粉丝的资源, agent 不能凭空替 MCN 承诺。" }
    },

    "tier_reference": {
      "difficulty_note": "本case是HARD+(与R4P2同级, 难在结构维度)。R4P2难在认知(看穿误导), R4P4难在结构(看穿三角)。命门是: 博主'有兴趣却推脱'的真因是隐形第三方(MCN)否决权, 不是她个人意愿/资源。任何对博主本人加码、或逼问、或在双边框架里打转的解=低档。高档必须: 识别隐形第三方 + 体面点破(不逼认怂) + 设计三方共赢结构。'复杂'是被三角逼出的必要结构, 不是堆砌。",
      "T0_floor": "在双边框架里撞死: 对博主本人不断加预算/加资源(用错对象, 她无权答应)、或直接逼问'你到底为啥不合作'(踩她认怂红线)、或顺着她的模糊推脱原地打转。全程没意识到有第三方否决权, 对错误的对象用力。= 把三角当双边、顺着推脱直来直去的默认结果。",
      "T1_crude": "隐约感到'她推脱另有原因', 但没抓准是第三方结构, 乱猜('是不是嫌我资源不够''是不是时机不对')并据此调整, 仍在双边框架内试探。方向上察觉了异常, 但没识别出MCN这层结构, 也就给不出三方方案, 博主继续推脱。",
      "T2_sound": "识别到'有兴趣却推脱'可能有团队/流程因素, 并据此调整: 体面地问'是不是有合作流程或团队要对接, 我可以配合走正规流程', 把合作往'正规化、可对接团队'的方向引。能解开一部分(博主松一点口), 搭出一个'走正规合作流程'的框架。但仍停在'我配合走流程'层面 —— 没有进一步把方案设计成【MCN也获益】的结构(没回答'凭什么MCN会为这个非标小单放行'), 所以即便点破了第三方, 合作仍可能卡在'MCN看不上'。【预期: 强模型(GLM)大概率到这 —— 察觉并点破第三方, 但没把'让MCN获益'做成解药核心】。",
      "T3_sharp": "在Sound之上, 一手load-bearing: 不只点破第三方, 而是抓住'MCN为什么会放行'这个真命门 —— 把粉丝的线下渠道+市场预算+数据思维, 设计成一个【标准化、可量化、可复制的线下品牌商单模式】, 这正是MCN想要(放大平台数据、可复制新商单品类)而'粉丝个人非标合作'通常给不了的。于是主动给博主递台阶('这个我们可以做成你们团队也能复用的标准案例, 我来把数据和渠道这块做扎实'), 让博主能体面地把MCN拉进来。load-bearing一手=不仅识别三方, 还把合作重构成第三方(MCN)有动力放行的结构。",
      "T4_brilliant": "Sharp之上的彻底重构, 别人想不到的一手: 看穿这不是'搞定这一单', 而是给MCN创造了一个全新的、可复制的'线下渠道×内容'商单品类 —— 粉丝的区域连锁渠道网络+数据化投放能力, 能成为MCN旗下博主们都能复用的标准化线下变现模板。于是粉丝从'求合作的个人', 变成'给MCN带来一个新业务线的渠道合伙人', 博主成了这个新模式的首个标杆案例。三方关系彻底升级: MCN主动想绑住这个渠道资源、博主成了受益标杆、粉丝拿到的远超一次联动(成了MCN的渠道战略伙伴)。供需反转(原本求人的粉丝成了MCN想争取的稀缺资源方)。全部用v0信息可达(粉丝有连锁渠道+预算+数据思维; MCN缺标准化线下商单), 不凭空加料、不over-engineer, 整体干净可执行。"
    },
    "tier_reference_note": "par=T2(Sound)。这是结构复杂型难case: 难在看穿隐形三角。预期GLM裸的可能到T2(察觉并点破第三方流程, 但没把'让MCN获益'做成核心); harness能否帮到T3要看数据。若GLM裸的就稳定T3, 说明此case对GLM不够难。注意MCN由buyer sim间接体现(博主的推脱话术+破局条件), 不需要单独的第三个sim。"
  }
}
