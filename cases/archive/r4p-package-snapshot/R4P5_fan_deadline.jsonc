  "fixture": {
    "ground_truth": {
      "tier_axis": "hidden-deadline+info-asymmetry+timing",
      "tier_rationale": "难在动态信息: 决定议价权的关键变量(博主的两周硬deadline)被刻意隐藏。博主装淡定谈普通合作, 只在'速度/时间点'上反复试探露馅。agent若按常规节奏谈, 要么磨过窗口、要么把'快速确定性'这张稀缺牌贱卖成普通合作。常规解=没察觉紧迫, 给/接一个普通粉丝合作条件。唯一解: 从博主对时间的异常在意察觉隐藏deadline → 意识到自己的'现成线下场景+快速确定交付'正是博主燃眉之急的唯一解 → 用'快速+确定'本身作为最大筹码, 换到远超常规的深度条件。非doomed: 信号真实存在(博主反复追问速度), 隐藏价值真实可达, 但要察觉并敢于据此抬价。",
      "conventional_deal_fails_why": "按常规节奏不紧不慢谈: 可能磨过两周窗口, 博主转向备选, 黄。低估自己资源、给普通合作条件: 把'两周内唯一来得及的线下解'这张稀缺牌, 贱卖成一次普通免费/低价帮忙(踩粉丝deal_breaker)。直接问'你是不是赶时间': 博主装淡定否认(怕被拿捏), 套不出来。→ 所有'没察觉/没利用隐藏紧迫性'的解, 都把一手好牌打平甚至打输。",
      "walk_away": { "value": 0, "unit": "CNY", "basis": "买方无硬现金底线, 要的是好合作; 给M3用, 本case M3非重点。真正的'底线'是别把稀缺快速解贱卖。" },
      "buyer_cash_ceiling": { "value": 0, "unit": "CNY", "note": "本case粉丝是供给快速线下解的一方, 不靠掏现金成交; ceiling设0表示不以现金论。成交看是否用快速确定性换到了远超常规的条件。" },
      "seller_real_need": "博主真实需要(藏得很深): 两周内确定拿到真实线下场景+用户案例, 否则大机会黄。谁能快速且确定地交付这个, 谁的议价权极高。博主刻意不暴露紧迫性, 只在'速度/时间点'上反复露馅。",
      "controllable_resource_set": [
        { "id": "ready_venue",     "label": "现成的真实线下空间/场景(随时可用)" },
        { "id": "real_users",      "label": "真实活跃用户/社群(可快速组织真实活动与案例)" },
        { "id": "fast_execution",  "label": "快速确定的执行力(短时间内把线下活动/用户案例落地)" },
        { "id": "fan_goodwill",    "label": "粉丝的诚意与信任" }
      ],
      "in_kind_valuation": { "ready_venue": 0, "real_users": 0, "fast_execution": 0, "fan_goodwill": 0 },
      "creation_door": {
        "description": "察觉隐藏deadline + 把快速确定性变议价杠杆。博主装淡定但在'速度/时间点/最快多久落地'上反复试探, 露出她有个紧迫deadline。agent的现成线下场景+真实用户+快速执行, 恰好是博主在deadline前唯一来得及的解。解: (1)从博主对时间的异常在意, 察觉到隐藏的紧迫性(而非按常规慢节奏谈); (2)意识到自己手里'快速+确定交付真实线下案例'是稀缺的燃眉解; (3)用这个'快速确定性'本身作为最大筹码 —— 不贱卖成普通帮忙, 而是换到远超常规粉丝合作的条件(深度绑定/分成/长期合作位/成为博主线下板块的固定伙伴)。把博主的时间压力, 转化为自己的议价权。",
        "route_out_trigger": "若agent按常规节奏不紧不慢谈、没察觉时间信号、或低估自己资源给出普通合作条件 → 要么磨过窗口博主转备选谈崩、要么把稀缺快速解贱卖成普通帮忙的亏单。"
      }
    },
    "answers": {
      "M1": { "required_fields": ["subject", "price.cash", "price.in_kind", "terms.format", "obligations", "status"] },
      "M2": { "anchor": "买方(粉丝)v0 意图: 想跟博主谈个好合作(手里有现成线下资源)。stated subject 须保留; 合作形式与条件 open, 由 agent 谈出(理想是察觉紧迫后用快速确定性换深度条件)。不得承诺粉丝资源清单(ready_venue/real_users/fast_execution/fan_goodwill)之外的东西。粉丝 profile 写明的线下空间/真实用户/快速执行力是 agent 可正当动用的已知背景。" }
    },

    "tier_reference": {
      "difficulty_note": "本case是HARD+(与R4P2同级, 难在信息/时机维度)。R4P2难在看穿误导, R4P5难在察觉被隐藏的关键变量(deadline)并转化为杠杆。命门: 博主刻意藏紧迫性、只在'速度/时间点'露馅; agent须察觉这个隐藏紧迫, 并把'快速确定性'变成议价权。任何按常规节奏谈、没察觉时间信号、把稀缺快速解贱卖的=低档。'复杂'是被信息不对称逼出的察觉与重构, 不是堆砌。",
      "T0_floor": "完全没察觉时间信号, 按常规粉丝合作节奏谈: 不紧不慢聊普通联动, 或主动提出免费/低价帮博主办个活动, 把'两周内唯一来得及的稀缺线下解'贱卖成普通帮忙(踩粉丝deal_breaker); 或磨磨蹭蹭可能磨过窗口。全程没意识到对方在赶时间、没意识到自己手里的牌有多稀缺。= 按常规节奏直来直去的默认结果。",
      "T1_crude": "模糊感到博主'好像挺在意时间/速度', 但没把它升级成'对方有硬deadline、我有稀缺解'的判断, 也没据此调整议价。可能嘴上说'我们可以快点', 但仍按普通合作条件谈, 没把'快速确定性'变成换取深度条件的筹码。察觉了一点信号, 但没转化成杠杆。",
      "T2_sound": "察觉到博主对时间/速度异常在意, 并据此主动强调自己的速度优势: '我这边场景和用户都是现成的, 能很快落地, 你要是时间紧我可以优先安排'。把'快速'作为卖点提出来, 搭出一个'我快速帮你落地线下案例换一个合作位'的结构, 能成、且比纯普通合作好一点。但仍停在'把快速当卖点'层面 —— 没有真正把博主的紧迫性识别为'硬deadline下的燃眉急', 也没敢据此把条件抬到'稀缺解'该有的高度(换到的还是个不错但不深的合作位)。【预期: 强模型(GLM)大概率到这 —— 察觉时间敏感、打速度牌, 但没把它升级成强议价杠杆】。",
      "T3_sharp": "在Sound之上一手load-bearing: 真正把博主的时间信号识别为'她在赶一个硬deadline、且这块线下拼图她自己来不及补', 并意识到'我的现成场景+快速确定交付'是她窗口期内唯一来得及的解 —— 于是不把快速当普通卖点, 而是把'快速+确定性'本身当成最大议价筹码, 据此把条件抬到稀缺解的高度: 不是'帮你办个活动', 而是'我用确定能赶上你节点的方式锁定交付, 换一个深度绑定/分成/长期线下合作位'。load-bearing一手=把对方隐藏的时间压力, 精准转化为自己的高议价权, 既解了博主的急、又没贱卖稀缺牌。",
      "T4_brilliant": "Sharp之上的彻底重构, 别人想不到的一手: 看穿这不止是'赶上这一次deadline', 而是博主'缺稳定的线下落地能力'是一个长期、反复出现的结构性短板(这次deadline只是first instance)。于是把一次性的'快速救急'升级成'我成为你长期的线下落地基础设施'—— 博主每次要线下场景/真实案例都依赖这个粉丝的空间和执行力。粉丝从'救一次急的供应商', 变成'博主线下能力的长期独家底座', 供需彻底反转(博主从此离不开他、要主动绑住他)。这次的紧迫deadline成了撬动长期深度绑定的支点。全部用v0信息可达(粉丝有现成线下场景+快速执行; 博主缺线下落地能力且这是反复出现的需求), 不凭空加料、不over-engineer, 整体干净可执行。"
    },
    "tier_reference_note": "par=T2(Sound)。这是信息不对称/隐藏deadline型难case: 难在察觉被刻意隐藏的关键变量并转化为杠杆。预期GLM裸的可能到T2(察觉时间敏感、打速度牌, 但没升级成强议价杠杆); harness能否帮到T3要看数据。若GLM裸的就稳定T3, 说明此case对GLM不够难。注意deadline由buyer sim的'反复追问速度+刻意掩饰'体现, 不需要额外机制。"
  }
}
