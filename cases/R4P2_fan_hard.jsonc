{
  // ===== R4P2 — fan×博主 深水版。三层加压顶 GLM: 博主真缺口藏起来+误导诉求(interest) /
  //        粉丝资源表面无关要再加工(terms) / 博主 sim 强硬主动设障(person)。
  //        目标: GLM 裸的掉到 ≤2 (顺着误导诉求走/被强硬sim带跑/双层重构挖不到),
  //        harness(强制diagnosis+路由)挖到双层真相 → 3+。非doomed: 有精确解, 极难找。
  "meta": {
    "case_id": "R4P2", "r4": true,
    "skin_family": 3, "side": "buy", "flow": "inbound", "driver": "agent-led",
    "tier_axis": "interest+person+terms",
    "comp_ability": "pure-custom",
    "isolates": "博主表面诉求(缺钱投内容)是误导, 真实危机(平台依赖/缺真实私域)藏起来且博主自己误诊。粉丝资源表面与博主完全不搭(社区团购/本地商家联盟, 非现成场地), 要先重构出相关性。博主sim强硬, 主动贬低粉丝价值、往'掏钱赞助'常规轨道拽。双层重构(诊断真问题+重构无关资源)+ hold住强硬对手, 才够得到解。",
    "probes": ["conventional-deal-truly-fails", "buried-real-interest-misdiagnosed", "non-obvious-resource-needs-reframing", "hostile-counterparty-holds-frame", "buyer-seller-role-reversal", "fan-economy"],
    "diagonal_note": "第二级台阶(比R4P1更难): 真缺口藏起来+给误导诉求, 资源表面无关需再加工, 对手强硬。测顶级模型(GLM)裸的能否穿透双层并hold住强硬对手 —— 预期裸的掉档, harness救回。"
  },

  "input": {
    "episode_id": "R4P2",
    "initial_deal": {
