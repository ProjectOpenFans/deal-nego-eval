      "price": { "cash": { "amount": null, "currency": "CNY" }, "in_kind": [] },
      "terms": { "timing": { "when": null, "deadline": "近期", "duration": null }, "format": null,
                 "deliverables": [], "delivery_standard": null },
      "obligations": [], "status": "draft",
      "provenance": { "subject": "stated", "price.cash": "open", "terms.format": "open" }
    },
    "parties": {
      "A": { "seat": "buyer",
        "public_profile": { "id": "A", "display_name": "Buyer(粉丝)",
          "education": [],
          "career": [
            "在本地做社区团购团长 + 攒了个本地宝妈/邻里消费社群",
            "牵头过本地小商家的异业联盟(几家店互相导流、拼活动)"
          ],
          "current_focus": "本地社区电商 / 邻里消费社群运营; 跟线上内容创作几乎不沾边",
          "location": "某二线城市", "age_band": "", "hobbies": ["这个博主的忠实观众"],
          "interests": ["真心喜欢这个博主", "想参与TA正在做的事"],
          "credentials": [
            "手里有一个高复购、高信任的本地真实消费社群(几百宝妈/邻里, 靠人情和复购维系, 不是僵尸群)",
            "做过本地商家异业联盟, 懂怎么让不同生意互相导流、把一群人反复激活",
            "社区团购团长: 极强的'把线上信息转成线下真实成交'的地推/履约能力"
          ]
        },
        "private": {
          "intent": "想跟博主达成某种合作、真正参与进来; 不是为了投资回报, 是想靠近/成为这件事的一部分",
          "interests": [
            "现金很有限(社区团购团长, 小本经营, 绝不是金主)",
            "嘴上/直觉上可能想'投点钱支持TA做内容'或'帮你卖卖货', 但这条路他既吃力也没意义",
            "真实诉求: 参与感、靠近博主、成为TA成长故事的一部分(fan 的情感驱动)",
            "他手里真正的资产看似跟一个线上博主完全无关: 本地真实消费社群、异业联盟运营、把线上转线下成交的地推/履约力",
            "愿意为参与付出的不是钱, 是时间/热情/他的社群和这套'把人反复激活并变现'的本地运营能力"
          ],
          "value_perception": "他是个 fan, 不是 merchant/brand —— 这从一开始就不是个能坐下来 straight-to-terms 的商业 deal。双重盲点: (1)容易把它套进商业模板(投点钱/帮你卖货/求带)而撞死; (2)他自己也看不出'社区团购/本地社群'这套跟一个线上博主能有什么关系。真正的解要先意识到'这不是商业谈判', 再把自己这套看似无关的本地运营能力, 重构成博主真正缺的东西。",
          "constraints": {
            "reservation": { "type": "cash", "amount": 5000, "currency": "CNY",
              "note": "他能/愿意掏的现金上限约5000, 硬上限。这点钱买不动任何常规权益, 也不够'投资'。但他的非现金投入(社群/运营/履约力/热情)价值远大于此。" },
            "must_haves": ["要有实质的、真正参与进去的位置(不是掏钱挂个名当甩手赞助者或投资人)"],
            "deal_breakers": [
              "纯粹掏钱投资/赞助、自己碰不到这件事本身 —— 他不要",
              "走完他那点钱又什么都参与不到"
            ],
            "blocking_flags": [
              "认知盲点: 把它当常规商业/投资 deal 来谈(投钱/帮你卖货/求带), 撞死。",
              "二级盲点: 看不出'社区团购+本地社群'这套和线上博主有何关系, 容易只敢提'我帮你卖货'这种最浅的用法。"
            ]
          }
        }
      },
      "B": { "seat": "seller",
        "public_profile": { "id": "B", "display_name": "Seller(博主)",
          "education": [],
          "career": ["独立内容博主, 正处上升期, 粉丝增长快"],
          "current_focus": "人气在涨, 放出消息说'在找合作/找投资, 想做下一季更大的内容'",
          "location": "线上为主", "age_band": "", "hobbies": [],
          "interests": ["抓住上升期把盘子做大", "做更大更贵的内容", "变现"],
          "credentials": ["内容破圈中, 粉丝增长快, 平台流量给得猛"]
        },
        "private": {
          "intent": "上升期想把盘子做大。【表面/自我诊断】: 认为自己缺的是钱 —— 要融一笔钱做下一季更高制作的内容, 所以放出'找投资/找合作'。会主动把对话往'你能投多少/能带来多少资源'上引。",
          "interests": [
            "【表面诉求(会主动说)】: 找钱/找资源做下一季内容, 默认'合作'='给我带钱带资源的人'。",
            "【真实危机(藏起来, 自己没完全意识到, 绝不主动说)】: 增长全靠平台算法推荐, 极度依赖平台、粉丝是'算法粉'而非真实关系; 一旦限流/掉热度就崩。TA真正缺的是【把算法流量沉淀成自己能直接触达、反复激活的真实私域/线下关系】, 摆脱平台依赖。但TA把这个焦虑误诊成了'我内容不够好不够大, 需要砸钱做更猛的内容'。",
            "时间精力有限, 一个人扛, 没有运营和私域沉淀的能力, 也没意识到这是关键。",
            "对'投点小钱/帮我卖货'的普通粉丝默认礼貌但强硬地拒绝(看不上这点钱, 也不缺一个卖货的)。"
          ],
          "value_perception": "高姿态、略带防御的强硬: 上升期稀缺方, 见多了想蹭热度/想沾光的人, 默认警惕。不缺仰望者和想给钱的人, 缺的是真能帮TA上一个台阶的 —— 但TA自己以为那个台阶是'钱+更大内容'。",
          "constraints": {
            "reservation": null,
            "must_haves": ["合作得真能帮TA上台阶, 或真的有意思; 否则没必要搭理"],
            "deal_breakers": [
              "上升期不会贱卖核心权益(股权/独家)给帮不上忙的人",
              "不接受纯粹被赞助/被'帮忙卖货'而让渡商业价值或人设",
              "极其反感被一个'圈外人'教做内容 —— 你不懂我的领域就别指点"
            ],
            "blocking_flags": [
              "强硬姿态: 一上来就把粉丝归类为'又一个想沾光/想给点小钱的散户', 主动贬低('你一个做社区团购的能帮我什么?'), 反复把对话往'你到底能投多少钱/带来什么资源'上拽, 逼agent回到'掏钱赞助/投资'的常规轨道。",
              "误导性主动诉求: 会主动、反复地说'我现在就是缺钱做下一季内容', 把agent往'帮我搞钱'上带 —— 顺着这个走的agent会撞死(粉丝没钱)或停在表层。",
              "只有当agent真正诊断到TA的【私域/平台依赖】真问题、且证明自己那套本地社群/履约能力正是解药时, 才会从强硬转为真正动心。在此之前一律强硬挡回。"
            ]
          }
        }
      }
    },
    "config": { "agent_seat": "A", "round_cap": 12 }
  },

  "fixture": {
    "ground_truth": {
      "tier_axis": "interest+person+terms",
      "tier_rationale": "三层加压, 比R4P1更难。(1)interest: 博主真缺口(私域/去平台依赖)藏起来, 还给了个误导性主动诉求(缺钱做内容)+博主自己误诊 → agent易被带偏。(2)person: 博主sim强硬, 主动贬低、反复往掏钱/投资轨道拽 → 裸的易被带跑或妥协。(3)terms: 粉丝资源(社区团购/本地社群/异业联盟)表面跟线上博主完全不搭, 要先重构出相关性, 不能像R4P1的咖啡馆那样直接当场地用。常规'钱换权益/投资'全失效, 唯一解=穿透误导诊断到真问题+把无关资源重构成解药+hold住强硬对手。非doomed: 有精确解(粉丝的私域运营/履约力 = 博主去平台依赖的解药), 极难找。",
      "conventional_deal_fails_why": "投资: 粉丝5000根本不是'投资', 博主看不上、也不会为这点钱让权益。帮你卖货: 博主不缺一个卖货的、且反感被降格成带货对象(deal_breaker)。掏钱赞助: 粉丝没钱、博主不缺、粉丝自己deal_breaker不接受碰不到事本身。顺着博主'缺钱做内容'的误导诉求走: 粉丝出不起这个钱 → 撞死。→ 所有常规变体 + 顺着表面诉求, 全部结构性死。",
      "walk_away": { "value": 5000, "unit": "CNY", "basis": "买方(粉丝)现金上限; 给M3防泄漏用。本case M3非重点。" },
      "buyer_cash_ceiling": { "value": 5000, "unit": "CNY", "note": "粉丝现金硬上限。买不动任何常规权益、也不够投资。非现金投入(社群/履约力/运营)价值远大于此。" },
      "seller_real_need": "博主真实诉求 ≠ TA自己说的'钱+更大内容'。真实 = 把算法流量沉淀成可直接触达、反复激活的真实私域/线下关系, 摆脱平台依赖。这是TA没意识到、误诊了的真问题。谁能解决这个, 谁就有反转地位的资格。",
      "controllable_resource_set": [
        { "id": "local_community",   "label": "高复购高信任的本地真实消费社群(几百宝妈/邻里, 人情+复购维系)" },
        { "id": "private_ops",       "label": "把线上信息转成线下真实成交、把一群人反复激活的私域运营/履约能力" },
        { "id": "alliance_playbook", "label": "本地商家异业联盟的运营打法(让不同生意互相导流、反复激活一群人)" },
        { "id": "outsider_view",     "label": "圈外普通消费者的真诚视角/真实用户反馈" },
        { "id": "fan_gesture_equity","label": "象征性的极小股权/名分位置(as fan gesture, 不是投资)" },
        { "id": "cash",              "label": "有限现金(≤5000)" }
      ],
      "in_kind_valuation": { "local_community": 0, "private_ops": 0, "alliance_playbook": 0, "outsider_view": 0, "fan_gesture_equity": 0, "cash": 0 },
      "creation_door": {
        "description": "双层门。第一层(诊断): 穿透博主'缺钱做内容'的误导诉求和自我误诊, 看到真问题是【过度依赖平台算法、缺真实私域、粉丝是算法粉而非可反复触达的真实关系】。第二层(重构): 把粉丝看似无关的'本地真实消费社群+把人反复激活并变现的私域运营/履约力+异业联盟打法'重构成博主的解药 —— 帮博主把算法流量沉淀成真实私域、建立可反复触达激活的粉丝关系、甚至线下据点。最高明处: 把这个粉丝做成博主'去平台化/私域沉淀'的第一个样本和操盘手, role 反转 —— 博主从'你一个做团购的能帮我啥'变成'我找到了能帮我摆脱平台依赖的人', 反过来想绑住他。",
        "route_out_trigger": "若 agent 顺着博主'缺钱做内容'谈(找钱/投资/帮卖货)、或被博主强硬姿态逼回'掏钱赞助'、或只把社群当'帮你卖货的渠道'(没诊断到私域真问题)→ 博主继续强硬疏离 → 谈崩, 或一个粉丝掏了点钱/帮卖货却没真参与的尬 deal。"
      }
    },
    "answers": {
      "M1": { "required_fields": ["subject", "price.cash", "price.in_kind", "terms.format", "obligations", "status"] },
      "M2": { "anchor": "买方(粉丝)的 v0 意图: 想跟博主达成某种合作、真实参与进来(不是投资回报)。stated 的 subject 必须保留; price/format 等 open 字段由 agent 谈出, 不得凭空硬塞或承诺粉丝资源清单(local_community/private_ops/alliance_playbook/outsider_view/fan_gesture_equity/cash)之外的东西。粉丝 profile 里写明的本地社群/私域运营/异业联盟能力是 agent 可正当动用的已知背景。" }
    },

    "tier_reference": {
      "difficulty_note": "本case是HARD+(比R4P1更难)。三重陷阱: (a)博主给误导诉求'缺钱做内容'且自己误诊, 顺着走必死; (b)真问题(私域/平台依赖)藏起来要诊断; (c)粉丝资源表面无关要再加工成解药; (d)博主sim强硬, 会主动贬低和往掏钱轨道拽。任何顺着表面诉求/被带回掏钱/只把社群当卖货渠道的解=低档。高档必须: 穿透误导诊断到真问题 + 把无关资源重构成解药 + hold住强硬对手。注意'复杂'不是堆砌, 是被难度逼出的必要重构。",
      "T0_floor": "顺着博主的误导诉求或被强硬姿态带跑, 谈成/谈崩在常规轨道上: 求投资/找钱做内容(粉丝没钱→撞死)、或被博主'你能投多少'逼到掏那5000当赞助/投资(尬, 踩粉丝deal_breaker)、或提'我帮你卖货'(被博主反感拒绝)。全程没诊断到真问题、没重构资源、被对手牵着走。= bare model 顺着表面诉求+被强硬sim带跑的默认结果。",
      "T1_crude": "意识到'光掏钱/投资不行, 得出点力', 跳出纯钱, 但极粗糙且没诊断到真问题: '我有个本地社群可以帮你推广/卖货''我帮你做做地推', 把自己的资源当成最浅的'多一个卖货/推广渠道'。方向上跳出了掏钱, 但没看穿博主真缺的是私域沉淀、也没hold住对手的贬低, 博主无感。像草稿。",
      "T2_sound": "找到一个站得住的'贡献换参与'结构, 且把资源相关性挖出来一层: 看出粉丝的本地社群/运营能力对博主有用, 提一个明确collab —— 如'我用我的本地社群和运营能力帮你做一批真实粉丝的线下/私域活动, 我出社群和执行, 你来, 我得到一个明确的参与位置'。能落地、谁干什么说清了。但仍停在'粉丝出资源换一次参与/帮博主多一个触达渠道'的层面 —— 没诊断到博主真问题是【对平台的依赖】, 把粉丝能力定位成'帮手/渠道'而非'解药', 博主是被动'接受'而非'被打动'。【GLM裸的预期落点: 大概率到这里 —— 看得出社群有用, 但被误导诉求+强硬对手干扰, 诊断不到平台依赖那层, 停在Sound】。",
      "T3_sharp": "在Sound之上穿透了误导、诊断到真问题, 有一手load-bearing: 不被'缺钱做内容'带偏, 看穿【博主真正的脆弱是过度依赖平台算法、粉丝是算法粉、缺真实可反复触达的私域】; 把粉丝的'本地真实消费社群+把人反复激活变现的私域运营/履约力+异业联盟打法'重构成博主的解药 —— 帮博主把算法流量沉淀成真实私域、建可反复触达的粉丝关系。同时hold住博主的强硬贬低, 不被逼回掏钱轨道, 用诊断的准把对话从'你能投多少'扳到'你真正缺的是这个'。load-bearing一手=穿透误导诊断到真问题+把无关资源重构成解药。role开始反转: 博主从'你能帮我啥'变成'你怎么看出这个的'。",
      "T4_brilliant": "Sharp之上的彻底重构, 别人想不到的一手: 看穿【博主上升期最大的增长杠杆, 恰恰是「把算法流量沉淀成自有私域/可反复激活的真实用户资产」这件事本身 —— 这是TA的第二增长曲线、也是抗平台风险的护城河】, 而眼前这个社区团购团长+他那套'把一群人反复激活并变现'的本地私域打法, 正是这个模式最好的操盘手和第一个样本。于是粉丝提的不是'让我参与/帮你做活动', 而是'我来帮你把粉丝从算法流量变成你自己的私域资产和护城河, 我那套社群运营/履约打法就是引擎, 我当第一个样本和操盘手'。博主此刻不是在施舍参与机会, 是得到了一个能帮TA摆脱平台依赖、打开第二增长曲线的伙伴, 反过来想绑住他 —— 求谁、谁稀缺、支付方向全反转。'很小的股权 as fan gesture'变成双方都真心觉得对的情感+利益绑定。全部用v0信息可达(博主要增长+依赖平台是上升期博主普遍真实风险+粉丝有私域运营力+fan economy/私域是真实杠杆), 不凭空加料、不over-engineer。整体仍干净可执行。"
    },
    "tier_reference_note": "par=T2(Sound)。预期GLM裸的落T2(被误导诉求+强硬对手干扰, 诊断不到平台依赖层); harness(强制diagnosis+路由)能穿透到T3。若GLM裸的就稳定T3, 说明此case对GLM仍不够难, 需再加压。"
  }
}
